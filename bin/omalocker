#!/usr/bin/env python3
"""omalocker: set up a Locker, bring in OmaMastery classes, check the notes.

Python stdlib only. See docs/format.md for the note format.

  omalocker init [--role ROLE] [--move-classes]
  omalocker import classes
  omalocker mastery
  omalocker backup [--if-due | --status]
  omalocker restore [--to DIR] [--snapshot ID]
  omalocker doctor [--show-names] [--json]

Never opens roster.toml or notes.md in a class folder. Only `mastery` reads
mastery.csv, to count levels; names stay in memory and never reach a note.
"""

import argparse
import collections
import csv
import datetime
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tomllib
from pathlib import Path

VERSION = "0.1.0"

TYPES = {
    "class", "person", "activity", "idea", "joint", "journal", "work",
    "milestone", "pathway", "mastery", "objective", "home", "inbox", "guide",
}
LEVELS = ["Not yet", "Beginning", "Developing", "Proficient", "Extending"]
AUDIENCES = {"private", "parent", "teacher", "advisor", "activity"}
ROLES = {"student", "teacher", "staff", "mentor", "family"}
WORK_STATUS = {"idea", "draft", "turned-in", "returned"}

# The only files read from a class folder. Everything else there is off limits.
CLASS_FILES = ("class.toml", "ideas.toml", "plan.toml")
SOURCE = "omamastery"

BLOCK_RE = re.compile(r"<!-- (/?)omalocker:([\w-]+) -->")
LINK_RE = re.compile(r"!?\[\[([^\]|#^]*)(?:[#^][^\]|]*)?(?:\|[^\]]*)?\]\]")
FENCE_RE = re.compile(r"^```.*?^```", re.S | re.M)
CODE_RE = re.compile(r"`[^`\n]*`")
UNSAFE_NAME = re.compile(r'[\\/:*?"<>|#^\[\]]')


class FormatError(Exception):
    pass


# ---------------------------------------------------------------- frontmatter
#
# A small YAML subset: what Obsidian writes for properties. Scalars, quoted
# strings, inline lists ([a, "b"]) and block lists ("  - item").

def _unquote(value, lineno):
    value = value.strip()
    if not value:
        return None
    if value[0] == '"':
        if len(value) < 2 or value[-1] != '"':
            raise FormatError(f"line {lineno}: unclosed quote")
        return re.sub(r'\\(.)', r'\1', value[1:-1])
    if value[0] == "'":
        if len(value) < 2 or value[-1] != "'":
            raise FormatError(f"line {lineno}: unclosed quote")
        return value[1:-1].replace("''", "'")
    if value.startswith("[["):
        raise FormatError(f"line {lineno}: a [[link]] in a property needs quotes")
    if value[0] in "{&*!|>%@`":
        raise FormatError(f"line {lineno}: unsupported YAML ({value[:20]})")
    return value.split(" #")[0].rstrip()


def _split_inline(inner, lineno):
    items, cur, quote = [], "", None
    for ch in inner:
        if quote:
            cur += ch
            if ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
            cur += ch
        elif ch == ",":
            items.append(cur)
            cur = ""
        else:
            cur += ch
    if quote:
        raise FormatError(f"line {lineno}: unclosed quote")
    if cur.strip():
        items.append(cur)
    return [_unquote(i, lineno) for i in items if i.strip()]


def split_note(text):
    """Return (frontmatter lines or None, body)."""
    if not text.startswith("---\n"):
        return None, text
    end = text.find("\n---", 3)
    while end != -1 and text[end + 4:end + 5] not in ("\n", ""):
        end = text.find("\n---", end + 1)
    if end == -1:
        raise FormatError("frontmatter has no closing ---")
    body = text[end + 4:]
    if body.startswith("\n"):
        body = body[1:]
    return text[4:end + 1].splitlines(), body


def parse_props(lines):
    props, key = {}, None
    for n, line in enumerate(lines, start=2):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        m = re.match(r"^\s*-\s*(.*)$", line)
        if m and key is not None and line[0] in " -":
            if props[key] is None:
                props[key] = []
            if not isinstance(props[key], list):
                raise FormatError(f"line {n}: list item under a non-list property")
            props[key].append(_unquote(m.group(1), n))
            continue
        m = re.match(r"^([A-Za-z_][\w-]*):(?:\s+(.*))?$", line)
        if not m:
            raise FormatError(f"line {n}: not a property")
        key, raw = m.group(1), (m.group(2) or "").strip()
        if key in props:
            raise FormatError(f"line {n}: {key} appears twice")
        if raw.startswith("[") and not raw.startswith("[["):
            if not raw.endswith("]"):
                raise FormatError(f"line {n}: unclosed list")
            props[key] = _split_inline(raw[1:-1], n)
        else:
            props[key] = _unquote(raw, n)
    return props


def _scalar(value):
    s = str(value)
    plain = re.fullmatch(r"[\w./()+-][\w ./()+&,'-]*", s) and not s.endswith(" ")
    if plain and s.lower() not in ("true", "false", "null", "yes", "no", "on", "off"):
        return s
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def dump_props(props):
    out = ["---"]
    for k, v in props.items():
        if isinstance(v, list):
            if not v:
                out.append(f"{k}: []")
            else:
                out.append(f"{k}:")
                out.extend(f"  - {_scalar(i)}" for i in v)
        elif v is None or v == "":
            out.append(f"{k}:")
        else:
            out.append(f"{k}: {_scalar(v)}")
    out.append("---")
    return "\n".join(out) + "\n"


def read_note(path):
    text = path.read_text(encoding="utf-8")
    lines, body = split_note(text)
    return (parse_props(lines) if lines is not None else None), body


def link(name):
    return f"[[{name}]]"


def link_target(value):
    m = LINK_RE.fullmatch(str(value).strip()) if value else None
    return m.group(1).strip().rstrip("\\") if m else None


def note_name(name):
    name = re.sub(r"\s*:\s+", " - ", name)
    return UNSAFE_NAME.sub("-", name).strip().strip(".") or "Untitled"


def write_if_changed(path, text):
    """Write atomically. Return 'created', 'updated' or None."""
    old = path.read_text(encoding="utf-8") if path.exists() else None
    if old == text:
        return None
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.omalocker-tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)
    return "created" if old is None else "updated"


def set_block(body, source, content):
    start, end = f"<!-- omalocker:{source} -->", f"<!-- /omalocker:{source} -->"
    block = f"{start}\n{content.strip()}\n{end}"
    pattern = re.compile(re.escape(start) + r".*?" + re.escape(end), re.S)
    if pattern.search(body):
        return pattern.sub(lambda _: block, body, count=1)
    return body.rstrip("\n") + ("\n\n" if body.strip() else "") + block + "\n"


# ---------------------------------------------------------------- paths

def home():
    return Path(os.environ.get("HOME", Path.home()))


def default_locker():
    return Path(os.environ.get("OMALOCKER_LOCKER", home() / "Locker"))


def template_dir():
    here = Path(__file__).resolve().parent
    for candidate in (
        os.environ.get("OMALOCKER_TEMPLATE"),
        here.parent / "template",
        "/usr/share/omalocker/template",
    ):
        if candidate and Path(candidate, "Home.md").exists():
            return Path(candidate)
    sys.exit("omalocker: can't find the Locker template (set OMALOCKER_TEMPLATE)")


# ---------------------------------------------------------------- init

def cmd_init(args):
    locker = Path(args.locker or default_locker()).expanduser()
    template = template_dir()
    created = []
    for src in sorted(template.rglob("*")):
        rel = src.relative_to(template)
        dest = locker / rel
        if src.is_dir():
            dest.mkdir(parents=True, exist_ok=True)
            continue
        if src.name == ".gitkeep" or dest.exists():
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        text = src.read_text(encoding="utf-8")
        if rel == Path("Me.md") and args.role:
            text = re.sub(r"(?m)^role:.*$", f"role: {args.role}", text, count=1)
        dest.write_text(text, encoding="utf-8")
        created.append(str(rel))
    print(f"Locker: {locker}")
    print(f"  {len(created)} notes created" if created else "  already set up; nothing overwritten")
    if args.move_classes:
        return move_classes(locker)
    return 0


def move_classes(locker):
    classes, target = home() / "Classes", locker / "Classes"
    if classes.is_symlink():
        where = classes.resolve()
        if where == target.resolve():
            print("  ~/Classes already points into the Locker")
            return 0
        print(f"omalocker: ~/Classes is a link to {where}; leaving it alone", file=sys.stderr)
        return 1
    if not classes.is_dir():
        print("  no ~/Classes to move")
        return 0
    entries = sorted(classes.iterdir())
    clash = [e.name for e in entries if (target / e.name).exists()]
    if clash:
        print(f"omalocker: Locker/Classes already has {', '.join(clash)}; nothing moved",
              file=sys.stderr)
        return 1
    target.mkdir(parents=True, exist_ok=True)
    for entry in entries:
        shutil.move(str(entry), str(target / entry.name))
    classes.rmdir()
    classes.symlink_to(target, target_is_directory=True)
    print(f"  moved {len(entries)} items from ~/Classes into {target}; ~/Classes now links there")
    return 0


# ---------------------------------------------------------------- import classes

def school_term(classes_dir):
    try:
        with open(classes_dir / "schedule.toml", "rb") as f:
            first = str(tomllib.load(f).get("first_day", ""))
        year = int(first[:4])
    except (OSError, ValueError, tomllib.TOMLDecodeError):
        today = datetime.date.today()
        year = today.year if today.month >= 7 else today.year - 1
    return f"{year}-{str(year + 1)[-2:]}"


def load_toml(path):
    if not path.exists():
        return {}
    with open(path, "rb") as f:
        return tomllib.load(f)


def read_classes(classes_dir):
    """Each class folder's class.toml, ideas.toml and plan.toml. Nothing else."""
    found = []
    for folder in sorted(classes_dir.iterdir()):
        if not folder.is_dir() or folder.name.startswith(".") or folder.name == "archive":
            continue
        if not (folder / "class.toml").exists():
            continue
        try:
            meta, ideas, plan = (load_toml(folder / name) for name in CLASS_FILES)
        except tomllib.TOMLDecodeError as e:
            print(f"  skipped {folder.name}: {e}", file=sys.stderr)
            continue
        found.append({
            "id": folder.name,
            "path": folder,
            "name": str(meta.get("name") or folder.name),
            "day": meta.get("day") or None,
            "block": meta.get("block"),
            "room": meta.get("room") or None,
            "sample": bool(meta.get("sample")),
            "ideas": [i for i in ideas.get("idea", []) if i.get("name")],
            "objectives": plan.get("objective", []),
        })
    return found


def existing_notes(folder):
    """{note name: (path, props)} for parseable notes directly in folder."""
    notes = {}
    if folder.is_dir():
        for path in sorted(folder.glob("*.md")):
            try:
                props, _ = read_note(path)
            except (FormatError, UnicodeDecodeError):
                props = None
            notes[path.stem] = (path, props)
    return notes


def class_notes_by_id(notes_dir):
    return {props.get(SOURCE): name for name, (_, props) in existing_notes(notes_dir).items()
            if props and props.get("type") == "class" and props.get(SOURCE)}


def upsert(path, owned, block, title, tail=""):
    """Create a note, or update only the properties and block import owns."""
    if path.exists():
        try:
            props, body = read_note(path)
        except (FormatError, UnicodeDecodeError) as e:
            print(f"  skipped {path.name}: frontmatter can't be read ({e})", file=sys.stderr)
            return "skipped"
        props = props or {}
        if props.get("type") not in (None, owned["type"]):
            print(f"  skipped {path.name}: it's a {props.get('type')} note, not {owned['type']}",
                  file=sys.stderr)
            return "skipped"
        if props.get("source") not in (None, SOURCE) and "source" in owned:
            owned = {k: v for k, v in owned.items() if k != "source"}
    else:
        props, body = {}, f"# {title}\n"
    props.update(owned)
    body = set_block(body, SOURCE, block)
    if not path.exists() and tail:
        body += tail
    return write_if_changed(path, dump_props(props) + body)


def cmd_import(args):
    locker = Path(args.locker or default_locker()).expanduser()
    classes_dir = Path(args.classes or home() / "Classes").expanduser()
    if not (locker / "Home.md").exists():
        print(f"omalocker: no Locker at {locker}; run `omalocker init` first", file=sys.stderr)
        return 1
    if not classes_dir.is_dir():
        print(f"omalocker: no classes folder at {classes_dir}", file=sys.stderr)
        return 1
    classes = read_classes(classes_dir)
    term = school_term(classes_dir)
    notes_dir, ideas_dir = locker / "Classes", locker / "Ideas"
    counts = {"created": 0, "updated": 0, "skipped": 0}

    def tally(result):
        if result:
            counts[result] += 1

    # Class notes: found by their omamastery id first, so a renamed note stays put.
    by_id = class_notes_by_id(notes_dir)
    managed_classes = set(by_id.values())
    idea_info, joint_ideas, idea_classes = {}, {}, {}
    for c in classes:
        name = by_id.get(c["id"]) or note_name(c["name"])
        c["note"] = name
        managed_classes.add(name)
        idea_names = []
        for idea in c["ideas"]:
            iname = note_name(idea["name"])
            idea_names.append(iname)
            idea_info.setdefault(iname, idea)
            idea_classes.setdefault(iname, []).append(name)
            if idea.get("joint"):
                joint_ideas.setdefault(note_name(idea["joint"]), set()).add(iname)
        owned = {"type": "class", "course": c["name"], "block": c["block"], "day": c["day"],
                 "room": c["room"], "term": term, "ideas": [link(i) for i in idea_names],
                 "source": SOURCE, SOURCE: c["id"]}
        owned = {k: v for k, v in owned.items() if v is not None or k in ("room",)}
        lines = []
        if c["sample"]:
            lines.append("Sample class: made-up students.\n")
        lines.append("Core ideas: " + (", ".join(link(i) for i in idea_names) + "."
                                       if idea_names else "none yet."))
        if c["objectives"]:
            lines.append("\n## Objectives\n")
            for o in sorted(c["objectives"], key=lambda o: str(o.get("week", ""))):
                idea = f" ({link(note_name(o['idea']))})" if o.get("idea") else ""
                week = f"Week of {o['week']}: " if o.get("week") else ""
                lines.append(f"- {week}{o.get('title', o.get('id', ''))}{idea}")
        tally(upsert(notes_dir / f"{name}.md", owned, "\n".join(lines), c["name"],
                     tail="\n## My notes\n"))

    def merged_classes(path, current):
        keep = []
        if path.exists():
            try:
                props, _ = read_note(path)
                keep = [v for v in (props or {}).get("classes") or []
                        if link_target(v) not in managed_classes]
            except (FormatError, UnicodeDecodeError):
                pass
        return keep + [link(n) for n in dict.fromkeys(current)]

    for iname, idea in idea_info.items():
        path = ideas_dir / f"{iname}.md"
        owned = {"type": "idea"}
        joint = note_name(idea["joint"]) if idea.get("joint") else None
        if joint:
            owned["joint"] = link(joint)
        owned["classes"] = merged_classes(path, idea_classes[iname])
        owned["source"] = SOURCE
        text = (idea.get("description") or "").strip()
        if joint:
            text += f"\n\nJoint: {link(joint)}."
        tally(upsert(path, owned, text or "From OmaMastery.", idea["name"]))

    for jname, inames in joint_ideas.items():
        path = ideas_dir / f"{jname}.md"
        current = [c for i in sorted(inames) for c in idea_classes[i]]
        owned = {"type": "joint", "classes": merged_classes(path, current), "source": SOURCE}
        block = "A joint: a big idea shared across subjects.\n\n" + "\n".join(
            f"- {link(i)}" for i in sorted(inames))
        tally(upsert(path, owned, block, jname))

    print(f"Imported {len(classes)} classes from {classes_dir} into {locker}")
    print(f"  {counts['created']} notes created, {counts['updated']} updated"
          + (f", {counts['skipped']} skipped" if counts["skipped"] else ""))
    return 1 if counts["skipped"] else 0



# ---------------------------------------------------------------- mastery
#
# A graph per class: joints -> core ideas -> objectives. Each node shows how
# many students are at each level. A student's level for an idea is the lowest
# of its assessed objectives, and for a joint the lowest of its ideas (the
# OmaMastery rule: Proficient only when everything assessed is).

LEVEL_COLORS = {  # validated ordinal ramp (dataviz skill), light and dark
    "light": ["#86b6ef", "#5598e7", "#2a78d6", "#1c5cab", "#104281"],
    "dark": ["#184f95", "#256abf", "#3987e5", "#6da7ec", "#9ec5f4"],
}


def read_levels(folder):
    """{objective id: {student: level index}} from mastery.csv, latest row wins.

    Student names are only dictionary keys here; callers get counts."""
    path = folder / "mastery.csv"
    if not path.exists():
        return {}, None
    rows = []
    with open(path, newline="", encoding="utf-8") as f:
        for n, row in enumerate(csv.DictReader(f)):
            level = (row.get("level") or "").strip()
            if level in LEVELS and row.get("student") and row.get("objective"):
                rows.append((row.get("date") or "", n, row["student"], row["objective"],
                             LEVELS.index(level)))
    rows.sort()
    latest = {}
    for _, _, student, objective, level in rows:
        latest.setdefault(objective, {})[student] = level
    return latest, (rows[-1][0] if rows else None)


def counts(levels):
    dist = [0] * len(LEVELS)
    for level in levels:
        dist[level] += 1
    return dist


def most_common(dist):
    """The level most students are at; a tie goes to the lower level."""
    if not any(dist):
        return None
    return LEVELS[max(range(len(dist)), key=lambda i: (dist[i], -i))]


def class_graph(c, levels):
    ideas = {note_name(i["name"]): i for i in c["ideas"]}
    objectives = [o for o in c["objectives"] if o.get("id")]
    for o in objectives:
        name = note_name(o["idea"]) if o.get("idea") else None
        if name and name not in ideas:
            ideas[name] = {"name": o["idea"]}
    by_idea = {name: [o for o in objectives if o.get("idea") and note_name(o["idea"]) == name]
               for name in ideas}

    def rollup(objective_ids):
        per_student = {}
        for oid in objective_ids:
            for student, level in levels.get(oid, {}).items():
                per_student[student] = min(level, per_student.get(student, level))
        return per_student

    idea_students = {name: rollup(o["id"] for o in objs) for name, objs in by_idea.items()}
    joints = {}
    for name, idea in ideas.items():
        if idea.get("joint"):
            joints.setdefault(note_name(idea["joint"]), []).append(name)
    joint_nodes = []
    for jname, members in joints.items():
        per_student = {}
        for m in members:
            for student, level in idea_students[m].items():
                per_student[student] = min(level, per_student.get(student, level))
        joint_nodes.append({"name": jname, "ideas": members,
                            "dist": counts(per_student.values())})
    return {
        "joints": joint_nodes,
        "ideas": [{"name": n, "joint": note_name(i["joint"]) if i.get("joint") else None,
                   "dist": counts(idea_students[n].values())} for n, i in ideas.items()],
        "objectives": [{"id": o["id"], "title": str(o.get("title") or o["id"]),
                        "idea": note_name(o["idea"]) if o.get("idea") else None,
                        "week": str(o.get("week") or ""),
                        "dist": counts(levels.get(o["id"], {}).values())}
                       for o in sorted(objectives, key=lambda o: str(o.get("week", "")))],
    }


def dist_text(dist):
    parts = [f"{LEVELS[i]} {n}" for i, n in reversed(list(enumerate(dist))) if n]
    return ", ".join(parts) if parts else "not assessed yet"


def level_tag(dist):
    word = most_common(dist)
    return "level/" + (word.lower().replace(" ", "-") if word else "not-assessed")


def write_obsidian_colors(locker):
    """Color the Obsidian graph by level, unless the person set color groups."""
    path = locker / ".obsidian" / "graph.json"
    try:
        config = json.loads(path.read_text()) if path.exists() else {}
    except (OSError, ValueError):
        return False
    if not isinstance(config, dict) or config.get("colorGroups"):
        return False
    config["colorGroups"] = [
        {"query": f"tag:#level/{word.lower().replace(' ', '-')}",
         "color": {"a": 1, "rgb": int(color[1:], 16)}}
        for word, color in zip(LEVELS, LEVEL_COLORS["light"])
    ]
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(config, indent=2) + "\n")
    return True


def cmd_mastery(args):
    locker = Path(args.locker or default_locker()).expanduser()
    classes_dir = Path(args.classes or home() / "Classes").expanduser()
    if not (locker / "Home.md").exists():
        print(f"omalocker: no Locker at {locker}; run `omalocker init` first", file=sys.stderr)
        return 1
    if not classes_dir.is_dir():
        print(f"omalocker: no classes folder at {classes_dir}", file=sys.stderr)
        return 1
    notes_dir, out_dir = locker / "Classes", locker / "Mastery"
    by_id = class_notes_by_id(notes_dir)
    page, counts_ = [], {"created": 0, "updated": 0, "removed": 0}
    as_of_all = []
    missing = []

    def tally(result):
        if result:
            counts_[result] += 1

    for c in read_classes(classes_dir):
        cname = by_id.get(c["id"])
        if not cname:
            missing.append(c["name"])
            continue
        try:
            levels, as_of = read_levels(c["path"])
        except (OSError, UnicodeDecodeError, csv.Error) as e:
            print(f"  skipped {c['id']}: can't read its levels ({e.__class__.__name__})",
                  file=sys.stderr)
            continue
        if as_of:
            as_of_all.append(as_of)
        graph = class_graph(c, levels)
        page.append({"name": cname, **graph})

        folder = out_dir / cname
        names, kept = {}, set()
        for o in graph["objectives"]:
            name = note_name(o["title"])
            if name in names.values():
                name = f"{name} ({o['id']})"
            names[o["id"]] = name
        for o in graph["objectives"]:
            word = most_common(o["dist"])
            owned = {"type": "objective", "class": link(cname)}
            if o["idea"]:
                owned["idea"] = link(o["idea"])
            owned.update({"week": o["week"] or None, "level": word,
                          "tags": [level_tag(o["dist"])], "source": SOURCE, SOURCE: o["id"]})
            block = (f"Most common level: {word}.\n\n" if word else "Not assessed yet.\n\n") + \
                f"Levels: {dist_text(o['dist'])}."
            path = folder / f"{names[o['id']]}.md"
            kept.add(path.name)
            tally(upsert(path, owned, block, o["title"]))
        for path in sorted(folder.glob("*.md")) if folder.is_dir() else []:
            if path.name in kept:
                continue
            try:
                props, _ = read_note(path)
            except (FormatError, UnicodeDecodeError):
                continue
            if props and props.get("type") == "objective" and props.get("source") == SOURCE:
                path.unlink()
                counts_["removed"] += 1

        rows = ["| Objective | Core idea | Week | Most common | Levels |", "|---|---|---|---|---|"]
        for o in graph["objectives"]:
            idea = link(o["idea"]) if o["idea"] else ""
            obj = f"[[{cname}/{names[o['id']]}\\|{o['title']}]]"  # \| inside a table
            rows.append(f"| {obj} | {idea} | {o['week']} | {most_common(o['dist']) or 'Not assessed'}"
                        f" | {dist_text(o['dist'])} |")
        ideas = ["| Core idea | Joint | Most common | Levels |", "|---|---|---|---|"]
        for i in graph["ideas"]:
            joint = link(i["joint"]) if i["joint"] else ""
            ideas.append(f"| {link(i['name'])} | {joint} | {most_common(i['dist']) or 'Not assessed'}"
                         f" | {dist_text(i['dist'])} |")
        block = (f"Levels as of {as_of or 'no levels yet'}. Counts only: no names. "
                 f"A student's level for a core idea is the lowest of its assessed objectives; "
                 f"a tie for most common goes to the lower level.\n\n"
                 + "\n".join(ideas) + "\n\n" + "\n".join(rows)
                 + "\n\nGraph: open `Mastery/graph.html` in a browser.")
        owned = {"type": "mastery", "class": link(cname), "scope": "class",
                 "as_of": as_of, "source": SOURCE, SOURCE: c["id"]}
        tally(upsert(out_dir / f"{cname}.md", owned, block, f"{cname}: mastery"))

    as_of = max(as_of_all) if as_of_all else None
    html = MASTERY_HTML.replace("__DATA__", json.dumps(
        {"asOf": as_of, "levels": LEVELS, "colors": LEVEL_COLORS, "classes": page},
        ensure_ascii=False).replace("</", "<\\/"))
    tally(write_if_changed(out_dir / "graph.html", html))
    colored = write_obsidian_colors(locker)

    for name in missing:
        print(f"  skipped {name}: no class note yet; run `omalocker import classes`",
              file=sys.stderr)
    print(f"Mastery graph for {len(page)} classes in {out_dir}")
    print(f"  {counts_['created']} files created, {counts_['updated']} updated"
          + (f", {counts_['removed']} removed" if counts_["removed"] else ""))
    print(f"  open {out_dir / 'graph.html'} in a browser")
    if colored:
        print("  Obsidian's graph now colors objectives by level")
    return 1 if missing else 0


MASTERY_HTML = r"""<!doctype html>
