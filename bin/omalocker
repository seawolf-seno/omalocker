</head>
<body>
<main>
  <h1>Mastery graph</h1>
  <p class="sub" id="sub"></p>
  <div class="bar tabs" id="tabs" role="group" aria-label="Class"></div>
  <div class="legend" id="legend"></div>
  <div class="scroll"><svg id="graph" role="img" aria-label="Mastery graph"></svg></div>
  <details><summary>Table</summary><div id="table"></div></details>
</main>
<div id="tip" role="tooltip"></div>
<script>
const DATA = __DATA__;
const L = DATA.levels, NS = "http://www.w3.org/2000/svg";
const color = i => `var(--l${i})`;
const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const most = d => { let b = -1; d.forEach((n, i) => { if (n && (b < 0 || n > d[b])) b = i; }); return b; };
const words = d => d.map((n, i) => n ? `${L[i]}: ${n}` : "").filter(Boolean).reverse().join("<br>") || "Not assessed yet";

$("sub").textContent = (DATA.asOf ? `Levels as of ${DATA.asOf}. ` : "No levels yet. ") +
  "Each node shows how many students are at each level; its color is the most common level (a tie goes to the lower one). " +
  "A core idea counts each student's lowest assessed objective in it.";
$("legend").innerHTML = L.map((w, i) => `<span><i class="sw" style="background:${color(i)}"></i>${w}</span>`).join("") +
  `<span><i class="sw none"></i>Not assessed</span>`;

const views = DATA.classes.map(c => ({ name: c.name, cls: c }));
if (DATA.classes.length > 1) views.push({ name: "All classes", all: true });
let current = 0;
function tabs() {
  $("tabs").innerHTML = views.map((v, i) =>
    `<button aria-pressed="${i === current}" data-i="${i}">${esc(v.name)}</button>`).join("");
  $("tabs").querySelectorAll("button").forEach(b => b.onclick = () => { current = +b.dataset.i; tabs(); draw(); });
}

function columns(v) {
  if (!v.all) {
    const c = v.cls;
    const jointOrder = c.joints.map(j => j.name);
    const ideas = [...c.ideas].sort((a, b) => jointOrder.indexOf(a.joint) - jointOrder.indexOf(b.joint));
    const ideaOrder = ideas.map(i => i.name);
    const objs = [...c.objectives].sort((a, b) => ideaOrder.indexOf(a.idea) - ideaOrder.indexOf(b.idea));
    return [
      { head: "Joints", nodes: c.joints.map(j => ({ key: "j:" + j.name, label: j.name, dist: j.dist })) },
      { head: "Core ideas", nodes: ideas.map(i => ({ key: "i:" + i.name, label: i.name, dist: i.dist,
          parent: i.joint ? "j:" + i.joint : null })) },
      { head: "Objectives", nodes: objs.map(o => ({ key: "o:" + o.id, label: o.title, dist: o.dist,
          parent: o.idea ? "i:" + o.idea : null, note: o.week ? `Week of ${o.week}` : "" })) },
    ];
  }
  const joints = new Map();
  DATA.classes.forEach(c => c.joints.forEach(j => {
    const prev = joints.get(j.name);
    joints.set(j.name, prev ? prev.map((n, i) => n + j.dist[i]) : [...j.dist]);
  }));
  const jointNames = [...joints.keys()];
  const ideas = DATA.classes.flatMap(c => c.ideas.map(i => ({ ...i, cls: c.name })))
    .sort((a, b) => jointNames.indexOf(a.joint) - jointNames.indexOf(b.joint));
  return [
    { head: "Joints", nodes: jointNames.map(n => ({ key: "j:" + n, label: n, dist: joints.get(n) })) },
    { head: "Core ideas, by class", nodes: ideas.map(i => ({ key: `i:${i.cls}/${i.name}`, label: i.name,
        note: i.cls, sub: i.cls, dist: i.dist, parent: i.joint ? "j:" + i.joint : null })) },
  ];
}

const W = 290, H = 56, GAP = 12, COLGAP = 90, PAD = 24, TOP = 44;
function el(tag, attrs, parent) {
  const e = document.createElementNS(NS, tag);
  for (const k in attrs) e.setAttribute(k, attrs[k]);
  if (parent) parent.appendChild(e);
  return e;
}
function clip(s, n) { return s.length > n ? s.slice(0, n - 1) + "…" : s; }

function draw() {
  const svg = $("graph"); svg.innerHTML = "";
  if (!views.length) { svg.outerHTML = `<div class="empty">No classes yet. Run omalocker import classes, then omalocker mastery.</div>`; return; }
  const cols = columns(views[current]);
  const tallest = Math.max(1, ...cols.map(c => c.nodes.length));
  const height = TOP + tallest * (H + GAP) + PAD;
  const width = PAD * 2 + cols.length * W + (cols.length - 1) * COLGAP;
  svg.setAttribute("width", width); svg.setAttribute("height", height);
  svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
  const pos = {}, edges = el("g", {}, svg), nodes = el("g", {}, svg);
  cols.forEach((col, ci) => {
    const x = PAD + ci * (W + COLGAP);
    const offset = (tallest - col.nodes.length) * (H + GAP) / 2;
    el("text", { x, y: 24, class: "head" }, svg).textContent = col.head;
    col.nodes.forEach((n, ni) => { pos[n.key] = { x, y: TOP + offset + ni * (H + GAP), n }; });
  });
  const links = [];
  for (const k in pos) {
    const p = pos[k], parent = p.n.parent && pos[p.n.parent];
    if (!parent) continue;
    const x1 = parent.x + W, y1 = parent.y + H / 2, x2 = p.x, y2 = p.y + H / 2, mx = (x1 + x2) / 2;
    links.push({ from: p.n.parent, to: k,
      path: el("path", { d: `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`, class: "edge" }, edges) });
  }
  for (const k in pos) {
    const { x, y, n } = pos[k], g = el("g", { class: "node", tabindex: 0 }, nodes);
    const m = most(n.dist);
    el("rect", { x, y, width: W, height: H, rx: 8, class: "card" }, g);
    if (m >= 0) el("rect", { x: x + 6, y: y + 6, width: 6, height: H - 12, rx: 3, fill: color(m) }, g);
    else el("rect", { x: x + 6.75, y: y + 6.75, width: 4.5, height: H - 13.5, rx: 2, fill: "none",
      stroke: "var(--muted)", "stroke-dasharray": "3 2", "stroke-width": 1.5 }, g);
    el("text", { x: x + 20, y: y + 22 }, g).textContent = clip(n.label, 36);
    el("text", { x: x + 20, y: y + 41, class: "muted" }, g).textContent =
      clip((m >= 0 ? "Most: " + L[m] : "Not assessed") + (n.sub ? " · " + n.sub : ""), 26);
    const total = n.dist.reduce((a, b) => a + b, 0);
    if (total) {
      let bx = x + W - 82; const bw = 72;
      n.dist.forEach((c, i) => {
        if (!c) return;
        const w = Math.max(2, bw * c / total - 2);
        el("rect", { x: bx, y: y + 34, width: w, height: 8, rx: 2, fill: color(i) }, g);
        bx += w + 2;
      });
    }
    const show = e => {
      g.classList.add("on");
      links.forEach(l => l.path.classList.toggle("on", l.from === k || l.to === k));
      const t = $("tip");
      t.innerHTML = `<strong>${esc(n.label)}</strong>${n.note ? "<br>" + esc(n.note) : ""}<br>${words(n.dist)}`;
      t.style.display = "block";
      const r = e.clientX !== undefined && e.type !== "focus" ? { x: e.clientX, y: e.clientY } : (() => {
        const b = g.getBoundingClientRect(); return { x: b.right, y: b.top }; })();
      t.style.left = Math.min(r.x + 14, innerWidth - t.offsetWidth - 8) + "px";
      t.style.top = Math.min(r.y + 14, innerHeight - t.offsetHeight - 8) + "px";
    };
    const hide = () => { g.classList.remove("on"); links.forEach(l => l.path.classList.remove("on")); $("tip").style.display = "none"; };
    g.addEventListener("mousemove", show); g.addEventListener("focus", show);
    g.addEventListener("mouseleave", hide); g.addEventListener("blur", hide);
  }
  $("table").innerHTML = `<table><thead><tr>${cols.map(c => `<th>${esc(c.head)}</th>`).join("")}</tr></thead><tbody>` +
    cols.flatMap(c => c.nodes.map((n, i) => ({ c: cols.indexOf(c), n }))).map(({ c, n }) =>
      `<tr>${cols.map((_, i) => `<td>${i === c ? esc(n.label) + (n.note ? ` <span style="color:var(--muted)">(${esc(n.note)})</span>` : "") + "<br>" + words(n.dist) : ""}</td>`).join("")}</tr>`).join("") +
    "</tbody></table>";
}
tabs(); draw();
</script>
</body>
</html>
"""


# ---------------------------------------------------------------- backup
#
# Encrypted backup of the whole Locker with restic (decided 2026-11-10: every
# 2 days, school IT holds the key). Settings come from school IT:
#
#   /etc/omalocker/backup.toml (or ~/.config/omalocker/backup.toml)
#   repository = "rest:https://backup.school.example/{user}"
#   password_file = "/etc/omalocker/backup-key"
#   every_days = 2
#   keep_last = 30        # 0: the device never deletes snapshots (append-only server)
#
# The password is passed to restic as a file, never on a command line.

BACKUP_DEFAULTS = {"every_days": 2, "keep_last": 30}
BACKUP_EXCLUDES = [".obsidian/workspace*.json", "*.omalocker-tmp", ".trash"]


class BackupError(Exception):
    pass


def backup_config_paths():
    if os.environ.get("OMALOCKER_BACKUP_CONFIG"):
        return [Path(os.environ["OMALOCKER_BACKUP_CONFIG"])]
    config_home = Path(os.environ.get("XDG_CONFIG_HOME") or home() / ".config")
    return [config_home / "omalocker" / "backup.toml", Path("/etc/omalocker/backup.toml")]


def load_backup_config():
    """The settings, or None when backup isn't set up on this device."""
    for path in backup_config_paths():
        if path.exists():
            try:
                with open(path, "rb") as f:
                    raw = tomllib.load(f)
            except (OSError, tomllib.TOMLDecodeError) as e:
                raise BackupError(f"can't read {path}: {e}")
            cfg = {**BACKUP_DEFAULTS, **raw, "path": path}
            if not cfg.get("repository") or not cfg.get("password_file"):
                raise BackupError(f"{path} needs repository and password_file")
            user = os.environ.get("USER") or home().name
            cfg["repository"] = str(cfg["repository"]).format(user=user, host=socket.gethostname())
            cfg["password_file"] = str(Path(str(cfg["password_file"])).expanduser())
            return cfg
    return None


def state_path():
    state_home = Path(os.environ.get("XDG_STATE_HOME") or home() / ".local" / "state")
    return state_home / "omalocker" / "backup.json"


def read_state():
    try:
        return json.loads(state_path().read_text())
    except (OSError, ValueError):
        return {}


def write_state(**changes):
    state = {**read_state(), **changes}
    path = state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n")
    os.replace(tmp, path)


def now():
    fixed = os.environ.get("OMALOCKER_NOW")  # tests
    if fixed:
        return datetime.datetime.fromisoformat(fixed)
    return datetime.datetime.now(datetime.timezone.utc)


def restic(cfg, *args):
    if not os.access(cfg["password_file"], os.R_OK):
        raise BackupError(f"can't read the backup key at {cfg['password_file']}; ask school IT")
    env = {**os.environ, "RESTIC_REPOSITORY": cfg["repository"],
           "RESTIC_PASSWORD_FILE": cfg["password_file"]}
    env.pop("RESTIC_PASSWORD", None)
    env.pop("RESTIC_PASSWORD_COMMAND", None)
    binary = os.environ.get("OMALOCKER_RESTIC", "restic")
    try:
        return subprocess.run([binary, *args], env=env, capture_output=True, text=True)
    except FileNotFoundError:
        raise BackupError("restic isn't installed (pacman -S restic)")


def restic_error(result):
    lines = [l for l in (result.stderr or "").strip().splitlines() if l.strip()]
    if not lines:
        return f"restic exited {result.returncode}"
    try:  # --json runs report errors as JSON lines
        msg = json.loads(lines[-1])
        return msg.get("message") or msg.get("error", {}).get("message") or lines[-1]
    except (ValueError, AttributeError):
        return lines[-1]


def backup_locker(cfg, locker):
    """Run one backup. Returns the summary dict restic printed."""
    probe = restic(cfg, "cat", "config")
    if probe.returncode == 10:  # no repository there yet
        made = restic(cfg, "init")
        if made.returncode != 0:
            raise BackupError(f"couldn't create the backup repository: {restic_error(made)}")
    elif probe.returncode != 0:
        raise BackupError(f"can't open the backup repository: {restic_error(probe)}")
    args = ["backup", str(locker), "--json", "--tag", "omalocker", "--host", socket.gethostname()]
    for pattern in BACKUP_EXCLUDES:
        args += ["--exclude", pattern]
    result = restic(cfg, *args)
    if result.returncode not in (0, 3):  # 3: done, but some files couldn't be read
        raise BackupError(f"backup failed: {restic_error(result)}")
    summary = {}
    for line in result.stdout.splitlines():
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if msg.get("message_type") == "summary":
            summary = msg
    if result.returncode == 3:
        summary["unreadable"] = max(1, result.stderr.count('"message_type":"error"'))
    keep = int(cfg.get("keep_last") or 0)
    if keep > 0:
        pruned = restic(cfg, "forget", "--tag", "omalocker", "--host", socket.gethostname(),
                        "--keep-last", str(keep), "--prune")
        if pruned.returncode != 0:
            summary["forget_error"] = restic_error(pruned)
    return summary


def backup_age(state):
    last = state.get("last_success")
    if not last:
        return None
    return now() - datetime.datetime.fromisoformat(last)


def describe_age(delta):
    hours = int(delta.total_seconds() // 3600)
    if hours < 1:
        return "less than an hour ago"
    if hours < 48:
        return f"{hours} hour{'s' if hours != 1 else ''} ago"
    return f"{hours // 24} days ago"


def cmd_backup(args):
    try:
        cfg = load_backup_config()
    except BackupError as e:
        print(f"omalocker: {e}", file=sys.stderr)
        return 1
    if cfg is None:
        print("omalocker: backup isn't set up on this device. School IT puts the settings in "
              "/etc/omalocker/backup.toml (see docs/backup.md).", file=sys.stderr)
        return 1
    locker = Path(args.locker or cfg.get("locker") or default_locker()).expanduser().resolve()
    state = read_state()
    age = backup_age(state)

    if args.status:
        print(f"Backup of {locker}")
        print(f"  to {cfg['repository']} (settings: {cfg['path']})")
        print(f"  last good backup: {describe_age(age) if age is not None else 'never'}"
              + (f", snapshot {state.get('snapshot')}" if age is not None else ""))
        if state.get("last_error"):
            print(f"  last problem ({state.get('last_error_at', '?')}): {state['last_error']}")
        try:
            listed = restic(cfg, "snapshots", "--tag", "omalocker", "--json")
            if listed.returncode == 0:
                snaps = json.loads(listed.stdout or "[]")
                print(f"  {len(snaps)} snapshot{'s' if len(snaps) != 1 else ''} in the repository")
            else:
                print(f"  can't list snapshots: {restic_error(listed)}")
        except (BackupError, ValueError) as e:
            print(f"  can't list snapshots: {e}")
        return 0

    every = datetime.timedelta(days=float(cfg["every_days"]))
    if args.if_due and age is not None and age < every:
        print(f"Last backup {describe_age(age)}; next one is due in "
              f"{describe_age(every - age).replace(' ago', '')}.")
        return 0
    if not (locker / "Home.md").exists():
        print(f"omalocker: no Locker at {locker}", file=sys.stderr)
        return 1
    try:
        summary = backup_locker(cfg, locker)
    except BackupError as e:
        write_state(last_error=str(e), last_error_at=now().isoformat())
        print(f"omalocker: {e}", file=sys.stderr)
        return 1
    write_state(last_success=now().isoformat(), snapshot=summary.get("snapshot_id", "")[:8],
                files=summary.get("total_files_processed"), last_error=None, last_error_at=None)
    print(f"Backed up {locker}: {summary.get('total_files_processed', '?')} files, "
          f"snapshot {summary.get('snapshot_id', '?')[:8]}")
    if summary.get("unreadable"):
        print(f"  {summary['unreadable']} file(s) couldn't be read and aren't in this backup")
    if summary.get("forget_error"):
        print(f"  old snapshots weren't cleaned up: {summary['forget_error']}")
    return 0


def cmd_restore(args):
    try:
        cfg = load_backup_config()
        if cfg is None:
            raise BackupError("backup isn't set up on this device (see docs/backup.md)")
        locker = Path(args.locker or cfg.get("locker") or default_locker()).expanduser()
        if args.to:
            dest = Path(args.to).expanduser()
        elif not locker.exists() or not any(locker.iterdir()):
            dest = locker
        else:
            raise BackupError(f"{locker} already has notes, so nothing was restored over it. "
                              f"Restore next to it with --to ~/Locker-restored, compare, then swap.")
        if dest.exists() and any(dest.iterdir()):
            raise BackupError(f"{dest} isn't empty; pick a new folder")
        listed = restic(cfg, "snapshots", "--tag", "omalocker", "--json")
        if listed.returncode != 0:
            raise BackupError(f"can't list snapshots: {restic_error(listed)}")
        snaps = sorted(json.loads(listed.stdout or "[]"), key=lambda s: s.get("time", ""))
        if args.snapshot:
            snaps = [s for s in snaps if s.get("id", "").startswith(args.snapshot)
                     or s.get("short_id") == args.snapshot]
        if not snaps:
            raise BackupError("no backup snapshot found")
        snap = snaps[-1]
        source = snap["paths"][0]
        dest.parent.mkdir(parents=True, exist_ok=True)
        scratch = dest.parent / f".omalocker-restore-{os.getpid()}"
        try:
            done = restic(cfg, "restore", snap["id"], "--target", str(scratch))
            if done.returncode != 0:
                raise BackupError(f"restore failed: {restic_error(done)}")
            restored = scratch / source.lstrip("/")
            if dest.exists():
                dest.rmdir()
            os.replace(restored, dest)
        finally:
            shutil.rmtree(scratch, ignore_errors=True)
    except (BackupError, ValueError, KeyError) as e:
        print(f"omalocker: {e}", file=sys.stderr)
        return 1
    count = sum(1 for _ in dest.rglob("*") if _.is_file())
    print(f"Restored snapshot {snap['id'][:8]} from {snap.get('time', '?')[:16]} "
          f"({snap.get('hostname', '?')}) into {dest}: {count} files")
    print(f"  check it: omalocker --locker {dest} doctor")
    return 0


def backup_problem(locker):
    """A line for doctor when this Locker's backup is missing or late, else None."""
    try:
        cfg = load_backup_config()
    except BackupError as e:
        return f"backup settings: {e}"
    if cfg is None:
        return None
    backed = Path(cfg.get("locker") or default_locker()).expanduser().resolve()
    if backed != locker.resolve():
        return None
    state = read_state()
    age = backup_age(state)
    if age is None:
        return "never backed up: run `omalocker backup`" + (
            f" (last try: {state['last_error']})" if state.get("last_error") else "")
    if age > datetime.timedelta(days=float(cfg["every_days"]) + 1):
        return f"last good backup was {describe_age(age)}" + (
            f"; last problem: {state['last_error']}" if state.get("last_error") else "")
    return None


# ---------------------------------------------------------------- doctor

def is_class_folder(path):
    return (path / "class.toml").exists() or path.name == "archive"


def locker_files(locker):
    """(notes to check, every file name for link resolution)."""
    notes, everything = [], []
    for root, dirs, files in os.walk(locker):
        root = Path(root)
        rel_root = root.relative_to(locker)
        in_classes = rel_root.parts[:1] == ("Classes",)
        skip_here = in_classes and len(rel_root.parts) > 1
        dirs[:] = sorted(d for d in dirs if not d.startswith("."))
        for f in sorted(files):
            if f.startswith(".") and f.endswith(".omalocker-tmp"):
                continue
            rel = rel_root / f
            everything.append(rel)
            if not f.endswith(".md") or f.startswith("."):
                continue
            if skip_here and is_class_folder(locker / Path(*rel_root.parts[:2])):
                continue  # OmaMastery's own files: never opened
            if in_classes and len(rel_root.parts) == 1 and f in ("AGENTS.md", "CLAUDE.md"):
                continue  # OmaMastery's agent guide
            notes.append(rel)
    return notes, everything


def link_index(files):
    stems, paths = set(), set()
    for rel in files:
        p = rel.as_posix().lower()
        if p.endswith(".md"):
            stems.add(rel.stem.lower())
            paths.add(p[:-3])
        else:
            stems.add(rel.name.lower())
            paths.add(p)
    return stems, paths


def resolves(target, index):
    stems, paths = index
    t = target.strip().lower().lstrip("/")
    if t.endswith(".md"):
        t = t[:-3]
    if not t:
        return True  # [[#heading]] in the same note
    return t in stems or t in paths or any(p.endswith("/" + t) for p in paths)


def check_note(rel, text, index):
    problems, broken = [], []
    try:
        lines, body = split_note(text)
        if lines is None:
            return ["no frontmatter (needs at least a type)"], [], {}
        props = parse_props(lines)
    except FormatError as e:
        return [f"frontmatter: {e}"], [], {}
    kind = props.get("type")
    folder = rel.parts[0] if len(rel.parts) > 1 else ""
    if not kind:
        problems.append("no type")
    elif kind not in TYPES:
        problems.append(f"unknown type {kind!r}")

    share = props.get("share")
    if "share" in props:
        if not isinstance(share, list):
            problems.append("share must be a list, like [private] or [parent, teacher]")
        else:
            bad = [s for s in share if s not in AUDIENCES]
            if bad:
                problems.append(f"share has unknown audience {', '.join(map(str, bad))}")
            if "private" in share and len(share) > 1:
                problems.append("share: private can't be combined with other audiences")
    if "private" in props:
        problems.append("private: true is replaced by share: [private]")

    if kind == "journal" and not (folder == "Journal"
                                  and re.fullmatch(r"\d{4}-\d{2}-\d{2}", rel.stem)):
        problems.append("journal notes go in Journal/ as YYYY-MM-DD.md")
    if kind == "milestone" and not (rel.parent.as_posix() == "Pathway/Milestones"
                                    and re.match(r"\d{4}-\d{2}-\d{2} ", rel.name)):
        problems.append("milestones go in Pathway/Milestones/ as YYYY-MM-DD <name>.md")
    if kind in ("mastery", "objective") and folder != "Mastery":
        problems.append(f"{kind} notes go in Mastery/")
    if kind == "objective" and props.get("level") and props["level"] not in LEVELS:
        problems.append(f"level {props['level']!r} isn't one of {', '.join(LEVELS)}")
    if kind == "home" and rel != Path("Home.md"):
        problems.append("type home is only for Home.md")
    if kind == "guide" and rel.name != "AGENTS.md":
        problems.append("type guide is only for AGENTS.md")
    if kind == "person" and props.get("role") and props["role"] not in ROLES:
        problems.append(f"role {props['role']!r} isn't one of {', '.join(sorted(ROLES))}")
    if kind == "work" and props.get("status") and props["status"] not in WORK_STATUS:
        problems.append(f"status {props['status']!r} isn't one of {', '.join(sorted(WORK_STATUS))}")
    if kind == "class" and props.get("day") and props["day"] not in ("A", "B"):
        problems.append("day must be A or B")

    open_block = None
    for m in BLOCK_RE.finditer(body):
        closing, name = m.group(1) == "/", m.group(2)
        if not closing:
            if open_block:
                problems.append(f"omalocker:{name} block starts inside omalocker:{open_block}")
            open_block = name
        elif open_block != name:
            problems.append(f"/omalocker:{name} closes a block that isn't open")
        else:
            open_block = None
    if open_block:
        problems.append(f"omalocker:{open_block} block is never closed")

    values = []
    for v in props.values():
        values.extend(v if isinstance(v, list) else [v])
    prose = CODE_RE.sub("", FENCE_RE.sub("", body))
    targets = [t for t in (link_target(v) for v in values if v) if t is not None]
    targets += [m.group(1).rstrip("\\") for m in LINK_RE.finditer(prose)]
    for t in targets:
        if not resolves(t, index):
            broken.append(t)
    return problems, broken, props


def cmd_doctor(args):
    locker = Path(args.locker or default_locker()).expanduser()
    if not locker.is_dir():
        print(f"omalocker: no Locker at {locker}", file=sys.stderr)
        return 1
    notes, everything = locker_files(locker)
    index = link_index(everything)
    report, hidden = [], 0
    for rel in notes:
        try:
            text = (locker / rel).read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as e:
            report.append({"note": str(rel), "problems": [f"can't read: {e.__class__.__name__}"],
                           "broken_links": []})
            continue
        problems, broken, props = check_note(rel, text, index)
        if not problems and not broken:
            continue
        sensitive = rel.parts[0] == "People" or "private" in (props.get("share") or [])
        label = str(rel)
        if sensitive and not args.show_names:
            hidden += 1
            label = f"{rel.parts[0]}/(a note: names hidden)"
        entry = {"note": label, "problems": problems,
                 "broken_links": broken if args.show_names else len(broken)}
        report.append(entry)

    backup = backup_problem(locker)
    if args.json:
        print(json.dumps({"locker": str(locker), "notes": len(notes), "issues": report,
                          "backup": backup}, indent=2))
        return 1 if report or backup else 0
    print(f"Checked {len(notes)} notes in {locker}")
    if backup:
        print(f"  backup: {backup}")
    if not report:
        print("  all good: every note has a type, valid frontmatter, and links that resolve")
        return 1 if backup else 0
    for entry in report:
        print(f"\n  {entry['note']}")
        for p in entry["problems"]:
            print(f"    - {p}")
        b = entry["broken_links"]
        if isinstance(b, list):
            for t in b:
                print(f"    - link to [[{t}]] doesn't resolve")
        elif b:
            print(f"    - {b} link{'s' if b > 1 else ''} don't resolve")
    if not args.show_names:
        print("\n  Link targets and People/ notes are hidden because they can be names."
              "\n  `omalocker doctor --show-names` shows them; don't paste that output anywhere.")
    print(f"\n  {len(report)} note{'s' if len(report) > 1 else ''} to fix")
    return 1


# ---------------------------------------------------------------- main

def main(argv=None):
    parser = argparse.ArgumentParser(prog="omalocker", description=__doc__.split("\n")[0])
    parser.add_argument("--version", action="version", version=f"omalocker {VERSION}")
    parser.add_argument("--locker", help="Locker folder (default ~/Locker)")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("init", help="set up ~/Locker from the template; never overwrites")
    p.add_argument("--role", choices=sorted(ROLES), help="fills in role on Me.md")
    p.add_argument("--move-classes", action="store_true",
                   help="move ~/Classes into the Locker and leave a link at ~/Classes")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("import", help="bring notes in from another app")
    p.add_argument("what", choices=["classes"])
    p.add_argument("--classes", help="OmaMastery folder (default ~/Classes)")
    p.set_defaults(func=cmd_import)

    p = sub.add_parser("mastery", help="mastery graph per class: Mastery/ notes and graph.html")
    p.add_argument("--classes", help="OmaMastery folder (default ~/Classes)")
    p.set_defaults(func=cmd_mastery)

    p = sub.add_parser("backup", help="encrypted backup of the Locker (restic)")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--if-due", action="store_true", help="only when the last good backup is due")
    g.add_argument("--status", action="store_true", help="last backup and snapshot count")
    p.set_defaults(func=cmd_backup)

    p = sub.add_parser("restore", help="restore the Locker from backup; never overwrites")
    p.add_argument("--to", help="folder to restore into (must be new or empty)")
    p.add_argument("--snapshot", help="snapshot id (default: the newest)")
    p.set_defaults(func=cmd_restore)

    p = sub.add_parser("doctor", help="check frontmatter, types, blocks and links")
    p.add_argument("--show-names", action="store_true",
                   help="show People/ notes and link targets (can print real names)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_doctor)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
