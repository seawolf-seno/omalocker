<script>
const DATA = __DATA__;
const L = DATA.levels, NS = "http://www.w3.org/2000/svg";
const color = i => `var(--l${i})`;
const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const most = d => { let b = -1; d.forEach((n, i) => { if (n && (b < 0 || n > d[b])) b = i; }); return b; };
const words = d => d.map((n, i) => n ? `${L[i]}: ${n}` : "").filter(Boolean).reverse().join("<br>") || "Not assessed yet";

$("sub").textContent = (DATA.asOf ? `Levels as of ${DATA.asOf}. ` : "No levels yet. ") +
  "Each node shows how many students are at each level; its color is the most common level (a tie goes to the lower one). " +
  "A core idea counts each student's lowest assessed objective in it.";
$("legend").innerHTML = L.map((w, i) => `<span><i class="sw" style="background:${color(i)}"></i>${w}</span>`).join("") +
  `<span><i class="sw none"></i>Not assessed</span>`;

const views = DATA.classes.map(c => ({ name: c.name, cls: c }));
if (DATA.classes.length > 1) views.push({ name: "All classes", all: true });
let current = 0;
function tabs() {
  $("tabs").innerHTML = views.map((v, i) =>
    `<button aria-pressed="${i === current}" data-i="${i}">${esc(v.name)}</button>`).join("");
  $("tabs").querySelectorAll("button").forEach(b => b.onclick = () => { current = +b.dataset.i; tabs(); draw(); });
}

function columns(v) {
  if (!v.all) {
    const c = v.cls;
    const jointOrder = c.joints.map(j => j.name);
    const ideas = [...c.ideas].sort((a, b) => jointOrder.indexOf(a.joint) - jointOrder.indexOf(b.joint));
    const ideaOrder = ideas.map(i => i.name);
    const objs = [...c.objectives].sort((a, b) => ideaOrder.indexOf(a.idea) - ideaOrder.indexOf(b.idea));
    return [
      { head: "Joints", nodes: c.joints.map(j => ({ key: "j:" + j.name, label: j.name, dist: j.dist })) },
      { head: "Core ideas", nodes: ideas.map(i => ({ key: "i:" + i.name, label: i.name, dist: i.dist,
          parent: i.joint ? "j:" + i.joint : null })) },
      { head: "Objectives", nodes: objs.map(o => ({ key: "o:" + o.id, label: o.title, dist: o.dist,
          parent: o.idea ? "i:" + o.idea : null, note: o.week ? `Week of ${o.week}` : "" })) },
    ];
  }
  const joints = new Map();
  DATA.classes.forEach(c => c.joints.forEach(j => {
    const prev = joints.get(j.name);
    joints.set(j.name, prev ? prev.map((n, i) => n + j.dist[i]) : [...j.dist]);
  }));
  const jointNames = [...joints.keys()];
  const ideas = DATA.classes.flatMap(c => c.ideas.map(i => ({ ...i, cls: c.name })))
    .sort((a, b) => jointNames.indexOf(a.joint) - jointNames.indexOf(b.joint));
  return [
    { head: "Joints", nodes: jointNames.map(n => ({ key: "j:" + n, label: n, dist: joints.get(n) })) },
    { head: "Core ideas, by class", nodes: ideas.map(i => ({ key: `i:${i.cls}/${i.name}`, label: i.name,
        note: i.cls, sub: i.cls, dist: i.dist, parent: i.joint ? "j:" + i.joint : null })) },
  ];
}

const W = 290, H = 56, GAP = 12, COLGAP = 90, PAD = 24, TOP = 44;
function el(tag, attrs, parent) {
  const e = document.createElementNS(NS, tag);
  for (const k in attrs) e.setAttribute(k, attrs[k]);
  if (parent) parent.appendChild(e);
  return e;
}
function clip(s, n) { return s.length > n ? s.slice(0, n - 1) + "…" : s; }

function draw() {
  const svg = $("graph"); svg.innerHTML = "";
  if (!views.length) { svg.outerHTML = `<div class="empty">No classes yet. Run omalocker import classes, then omalocker mastery.</div>`; return; }
  const cols = columns(views[current]);
  const tallest = Math.max(1, ...cols.map(c => c.nodes.length));
  const height = TOP + tallest * (H + GAP) + PAD;
  const width = PAD * 2 + cols.length * W + (cols.length - 1) * COLGAP;
  svg.setAttribute("width", width); svg.setAttribute("height", height);
  svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
  const pos = {}, edges = el("g", {}, svg), nodes = el("g", {}, svg);
  cols.forEach((col, ci) => {
    const x = PAD + ci * (W + COLGAP);
    const offset = (tallest - col.nodes.length) * (H + GAP) / 2;
    el("text", { x, y: 24, class: "head" }, svg).textContent = col.head;
    col.nodes.forEach((n, ni) => { pos[n.key] = { x, y: TOP + offset + ni * (H + GAP), n }; });
  });
  const links = [];
  for (const k in pos) {
    const p = pos[k], parent = p.n.parent && pos[p.n.parent];
    if (!parent) continue;
    const x1 = parent.x + W, y1 = parent.y + H / 2, x2 = p.x, y2 = p.y + H / 2, mx = (x1 + x2) / 2;
    links.push({ from: p.n.parent, to: k,
      path: el("path", { d: `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`, class: "edge" }, edges) });
  }
  for (const k in pos) {
    const { x, y, n } = pos[k], g = el("g", { class: "node", tabindex: 0 }, nodes);
    const m = most(n.dist);
    el("rect", { x, y, width: W, height: H, rx: 8, class: "card" }, g);
    if (m >= 0) el("rect", { x: x + 6, y: y + 6, width: 6, height: H - 12, rx: 3, fill: color(m) }, g);
    else el("rect", { x: x + 6.75, y: y + 6.75, width: 4.5, height: H - 13.5, rx: 2, fill: "none",
      stroke: "var(--muted)", "stroke-dasharray": "3 2", "stroke-width": 1.5 }, g);
    el("text", { x: x + 20, y: y + 22 }, g).textContent = clip(n.label, 36);
    el("text", { x: x + 20, y: y + 41, class: "muted" }, g).textContent =
      clip((m >= 0 ? "Most: " + L[m] : "Not assessed") + (n.sub ? " · " + n.sub : ""), 26);
    const total = n.dist.reduce((a, b) => a + b, 0);
    if (total) {
      let bx = x + W - 82; const bw = 72;
      n.dist.forEach((c, i) => {
        if (!c) return;
        const w = Math.max(2, bw * c / total - 2);
        el("rect", { x: bx, y: y + 34, width: w, height: 8, rx: 2, fill: color(i) }, g);
        bx += w + 2;
      });
    }
    const show = e => {
      g.classList.add("on");
      links.forEach(l => l.path.classList.toggle("on", l.from === k || l.to === k));
      const t = $("tip");
      t.innerHTML = `<strong>${esc(n.label)}</strong>${n.note ? "<br>" + esc(n.note) : ""}<br>${words(n.dist)}`;
      t.style.display = "block";
      const r = e.clientX !== undefined && e.type !== "focus" ? { x: e.clientX, y: e.clientY } : (() => {
        const b = g.getBoundingClientRect(); return { x: b.right, y: b.top }; })();
      t.style.left = Math.min(r.x + 14, innerWidth - t.offsetWidth - 8) + "px";
      t.style.top = Math.min(r.y + 14, innerHeight - t.offsetHeight - 8) + "px";
    };
    const hide = () => { g.classList.remove("on"); links.forEach(l => l.path.classList.remove("on")); $("tip").style.display = "none"; };
    g.addEventListener("mousemove", show); g.addEventListener("focus", show);
    g.addEventListener("mouseleave", hide); g.addEventListener("blur", hide);
  }
  $("table").innerHTML = `<table><thead><tr>${cols.map(c => `<th>${esc(c.head)}</th>`).join("")}</tr></thead><tbody>` +
    cols.flatMap(c => c.nodes.map((n, i) => ({ c: cols.indexOf(c), n }))).map(({ c, n }) =>
      `<tr>${cols.map((_, i) => `<td>${i === c ? esc(n.label) + (n.note ? ` <span style="color:var(--muted)">(${esc(n.note)})</span>` : "") + "<br>" + words(n.dist) : ""}</td>`).join("")}</tr>`).join("") +
    "</tbody></table>";
}
tabs(); draw();
</script>
</body>
</html>
"""


# ---------------------------------------------------------------- backup
#
# Encrypted backup of the whole Locker with restic (decided 2026-11-10: every
# 2 days, school IT holds the key). Settings come from school IT:
#
#   /etc/omalocker/backup.toml (or ~/.config/omalocker/backup.toml)
#   repository = "rest:https://backup.school.example/{user}"
#   password_file = "/etc/omalocker/backup-key"
#   every_days = 2
#   keep_last = 30        # 0: the device never deletes snapshots (append-only server)
#
# The password is passed to restic as a file, never on a command line.

BACKUP_DEFAULTS = {"every_days": 2, "keep_last": 30}
BACKUP_EXCLUDES = [".obsidian/workspace*.json", "*.omalocker-tmp", ".trash"]


class BackupError(Exception):
    pass


def backup_config_paths():
    if os.environ.get("OMALOCKER_BACKUP_CONFIG"):
        return [Path(os.environ["OMALOCKER_BACKUP_CONFIG"])]
    config_home = Path(os.environ.get("XDG_CONFIG_HOME") or home() / ".config")
    return [config_home / "omalocker" / "backup.toml", Path("/etc/omalocker/backup.toml")]


def load_backup_config():
    """The settings, or None when backup isn't set up on this device."""
    for path in backup_config_paths():
        if path.exists():
            try:
                with open(path, "rb") as f:
                    raw = tomllib.load(f)
            except (OSError, tomllib.TOMLDecodeError) as e:
                raise BackupError(f"can't read {path}: {e}")
            cfg = {**BACKUP_DEFAULTS, **raw, "path": path}
            if not cfg.get("repository") or not cfg.get("password_file"):
                raise BackupError(f"{path} needs repository and password_file")
            user = os.environ.get("USER") or home().name
            cfg["repository"] = str(cfg["repository"]).format(user=user, host=socket.gethostname())
            cfg["password_file"] = str(Path(str(cfg["password_file"])).expanduser())
            return cfg
    return None


def state_path():
    state_home = Path(os.environ.get("XDG_STATE_HOME") or home() / ".local" / "state")
    return state_home / "omalocker" / "backup.json"


def read_state():
    try:
        return json.loads(state_path().read_text())
    except (OSError, ValueError):
        return {}


def write_state(**changes):
    state = {**read_state(), **changes}
    path = state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n")
    os.replace(tmp, path)


def now():
    fixed = os.environ.get("OMALOCKER_NOW")  # tests
    if fixed:
        return datetime.datetime.fromisoformat(fixed)
    return datetime.datetime.now(datetime.timezone.utc)


def restic(cfg, *args):
    if not os.access(cfg["password_file"], os.R_OK):
        raise BackupError(f"can't read the backup key at {cfg['password_file']}; ask school IT")
    env = {**os.environ, "RESTIC_REPOSITORY": cfg["repository"],
           "RESTIC_PASSWORD_FILE": cfg["password_file"]}
    env.pop("RESTIC_PASSWORD", None)
    env.pop("RESTIC_PASSWORD_COMMAND", None)
    binary = os.environ.get("OMALOCKER_RESTIC", "restic")
    try:
        return subprocess.run([binary, *args], env=env, capture_output=True, text=True)
    except FileNotFoundError:
        raise BackupError("restic isn't installed (pacman -S restic)")


def restic_error(result):
    lines = [l for l in (result.stderr or "").strip().splitlines() if l.strip()]
    if not lines:
        return f"restic exited {result.returncode}"
    try:  # --json runs report errors as JSON lines
        msg = json.loads(lines[-1])
        return msg.get("message") or msg.get("error", {}).get("message") or lines[-1]
    except (ValueError, AttributeError):
        return lines[-1]


def backup_locker(cfg, locker):
    """Run one backup. Returns the summary dict restic printed."""
    probe = restic(cfg, "cat", "config")
    if probe.returncode == 10:  # no repository there yet
        made = restic(cfg, "init")
        if made.returncode != 0:
            raise BackupError(f"couldn't create the backup repository: {restic_error(made)}")
    elif probe.returncode != 0:
        raise BackupError(f"can't open the backup repository: {restic_error(probe)}")
    args = ["backup", str(locker), "--json", "--tag", "omalocker", "--host", socket.gethostname()]
    for pattern in BACKUP_EXCLUDES:
        args += ["--exclude", pattern]
    result = restic(cfg, *args)
    if result.returncode not in (0, 3):  # 3: done, but some files couldn't be read
        raise BackupError(f"backup failed: {restic_error(result)}")
    summary = {}
    for line in result.stdout.splitlines():
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if msg.get("message_type") == "summary":
            summary = msg
    if result.returncode == 3:
        summary["unreadable"] = max(1, result.stderr.count('"message_type":"error"'))
    keep = int(cfg.get("keep_last") or 0)
    if keep > 0:
        pruned = restic(cfg, "forget", "--tag", "omalocker", "--host", socket.gethostname(),
                        "--keep-last", str(keep), "--prune")
        if pruned.returncode != 0:
            summary["forget_error"] = restic_error(pruned)
    return summary


def backup_age(state):
    last = state.get("last_success")
    if not last:
        return None
    return now() - datetime.datetime.fromisoformat(last)


def describe_age(delta):
    hours = int(delta.total_seconds() // 3600)
    if hours < 1:
        return "less than an hour ago"
    if hours < 48:
        return f"{hours} hour{'s' if hours != 1 else ''} ago"
    return f"{hours // 24} days ago"


def cmd_backup(args):
    try:
        cfg = load_backup_config()
    except BackupError as e:
        print(f"omalocker: {e}", file=sys.stderr)
        return 1
    if cfg is None:
        print("omalocker: backup isn't set up on this device. School IT puts the settings in "
              "/etc/omalocker/backup.toml (see docs/backup.md).", file=sys.stderr)
        return 1
    locker = Path(args.locker or cfg.get("locker") or default_locker()).expanduser().resolve()
    done = graduated()
    if done and not args.status:
        print(f"This Locker graduated on {done['graduated'][:10]}: no more backups. "
              "School IT deletes the old ones (docs/graduation.md).")
        return 0 if args.if_due else 1
    state = read_state()
    age = backup_age(state)

    if args.status:
        print(f"Backup of {locker}")
        print(f"  to {cfg['repository']} (settings: {cfg['path']})")
        print(f"  last good backup: {describe_age(age) if age is not None else 'never'}"
              + (f", snapshot {state.get('snapshot')}" if age is not None else ""))
        if state.get("last_error"):
            print(f"  last problem ({state.get('last_error_at', '?')}): {state['last_error']}")
        try:
            listed = restic(cfg, "snapshots", "--tag", "omalocker", "--json")
            if listed.returncode == 0:
                snaps = json.loads(listed.stdout or "[]")
                print(f"  {len(snaps)} snapshot{'s' if len(snaps) != 1 else ''} in the repository")
            else:
                print(f"  can't list snapshots: {restic_error(listed)}")
        except (BackupError, ValueError) as e:
            print(f"  can't list snapshots: {e}")
        return 0

    every = datetime.timedelta(days=float(cfg["every_days"]))
    if args.if_due and age is not None and age < every:
        print(f"Last backup {describe_age(age)}; next one is due in "
              f"{describe_age(every - age).replace(' ago', '')}.")
        return 0
    if not (locker / "Home.md").exists():
        print(f"omalocker: no Locker at {locker}", file=sys.stderr)
        return 1
    try:
        summary = backup_locker(cfg, locker)
    except BackupError as e:
        write_state(last_error=str(e), last_error_at=now().isoformat())
        print(f"omalocker: {e}", file=sys.stderr)
        return 1
    write_state(last_success=now().isoformat(), snapshot=summary.get("snapshot_id", "")[:8],
                files=summary.get("total_files_processed"), last_error=None, last_error_at=None)
    print(f"Backed up {locker}: {summary.get('total_files_processed', '?')} files, "
          f"snapshot {summary.get('snapshot_id', '?')[:8]}")
    if summary.get("unreadable"):
        print(f"  {summary['unreadable']} file(s) couldn't be read and aren't in this backup")
    if summary.get("forget_error"):
        print(f"  old snapshots weren't cleaned up: {summary['forget_error']}")
    return 0


def cmd_restore(args):
    try:
        cfg = load_backup_config()
        if cfg is None:
            raise BackupError("backup isn't set up on this device (see docs/backup.md)")
        locker = Path(args.locker or cfg.get("locker") or default_locker()).expanduser()
        if args.to:
            dest = Path(args.to).expanduser()
        elif not locker.exists() or not any(locker.iterdir()):
            dest = locker
        else:
            raise BackupError(f"{locker} already has notes, so nothing was restored over it. "
                              f"Restore next to it with --to ~/Locker-restored, compare, then swap.")
        if dest.exists() and any(dest.iterdir()):
            raise BackupError(f"{dest} isn't empty; pick a new folder")
        listed = restic(cfg, "snapshots", "--tag", "omalocker", "--json")
        if listed.returncode != 0:
            raise BackupError(f"can't list snapshots: {restic_error(listed)}")
        snaps = sorted(json.loads(listed.stdout or "[]"), key=lambda s: s.get("time", ""))
        if args.snapshot:
            snaps = [s for s in snaps if s.get("id", "").startswith(args.snapshot)
                     or s.get("short_id") == args.snapshot]
        if not snaps:
            raise BackupError("no backup snapshot found")
        snap = snaps[-1]
        source = snap["paths"][0]
        dest.parent.mkdir(parents=True, exist_ok=True)
        scratch = dest.parent / f".omalocker-restore-{os.getpid()}"
        try:
            done = restic(cfg, "restore", snap["id"], "--target", str(scratch))
            if done.returncode != 0:
                raise BackupError(f"restore failed: {restic_error(done)}")
            restored = scratch / source.lstrip("/")
            if dest.exists():
                dest.rmdir()
            os.replace(restored, dest)
        finally:
            shutil.rmtree(scratch, ignore_errors=True)
    except (BackupError, ValueError, KeyError) as e:
        print(f"omalocker: {e}", file=sys.stderr)
        return 1
    count = sum(1 for _ in dest.rglob("*") if _.is_file())
    print(f"Restored snapshot {snap['id'][:8]} from {snap.get('time', '?')[:16]} "
          f"({snap.get('hostname', '?')}) into {dest}: {count} files")
    print(f"  check it: omalocker --locker {dest} doctor")
    return 0


def backup_problem(locker):
    """A line for doctor when this Locker's backup is missing or late, else None."""
    if graduated():
        return None
    try:
        cfg = load_backup_config()
    except BackupError as e:
        return f"backup settings: {e}"
    if cfg is None:
        return None
    backed = Path(cfg.get("locker") or default_locker()).expanduser().resolve()
    if backed != locker.resolve():
        return None
    state = read_state()
    age = backup_age(state)
    if age is None:
        return "never backed up: run `omalocker backup`" + (
            f" (last try: {state['last_error']})" if state.get("last_error") else "")
    if age > datetime.timedelta(days=float(cfg["every_days"]) + 1):
        return f"last good backup was {describe_age(age)}" + (
            f"; last problem: {state['last_error']}" if state.get("last_error") else "")
    return None


# ---------------------------------------------------------------- views
#
# A view is the part of a student's Locker one audience may see (docs/plan.md,
# "Views: who sees what"). Views are built here, on the device, into a folder
# outside the Locker; only views ever leave the device.

VIEW_FORMAT = 1
# The parent view opens on these (plus Me.md); everything else is one click away.
PARENT_SUMMARY = {"class", "mastery", "milestone", "pathway"}
# Not the student's own writing: share: [private] doesn't hide them.
CANT_HIDE = {"milestone", "mastery", "objective"}
ADVISOR_TYPES = {"class", "idea", "joint", "mastery", "activity", "pathway", "milestone"}


class ViewError(Exception):
    pass


def views_dir():
    if os.environ.get("OMALOCKER_VIEWS"):
        return Path(os.environ["OMALOCKER_VIEWS"])
    state_home = Path(os.environ.get("XDG_STATE_HOME") or home() / ".local" / "state")
    return state_home / "omalocker" / "views"


def load_notes(locker):
    """(notes, skipped): notes as [(rel, props, text)]; skipped counts notes
    whose frontmatter can't be read, which go in no view."""
    notes, skipped = [], 0
    for rel in locker_files(locker)[0]:
        try:
            text = (locker / rel).read_text(encoding="utf-8")
            lines, _ = split_note(text)
            props = parse_props(lines) if lines is not None else None
        except (OSError, UnicodeDecodeError, FormatError):
            props = None
        if not props or not props.get("type"):
            skipped += 1
            continue
        notes.append((rel, props, text))
    return notes, skipped


def share_of(props):
    share = props.get("share") or []
    return [str(s) for s in (share if isinstance(share, list) else [share])]


def linked_names(props):
    """Lowercased note names this note's properties link to."""
    names = set()
    for v in props.values():
        for item in v if isinstance(v, list) else [v]:
            t = link_target(item) if item else None
            if t:
                names.add(t.lower().rsplit("/", 1)[-1].removesuffix(".md"))
    return names


def plan_views(notes):
    """{(audience, scope): {rel: summary}} for a student's notes."""
    me = next((p for rel, p, _ in notes if rel == Path("Me.md")), None)
    if me is None:
        raise ViewError("no Me.md: views are built from a student's Locker")
    if me.get("role") != "student":
        raise ViewError(f"Me.md has role {me.get('role') or '(none)'}; views are built "
                        "only from a student's Locker (role: student)")
    classes = sorted(rel.stem for rel, p, _ in notes
                     if p.get("type") == "class" and rel.parent == Path("Classes"))
    activities = sorted(rel.stem for rel, p, _ in notes if p.get("type") == "activity")
    views = {("parent", None): {}, ("advisor", None): {}}
    views.update({("teacher", c): {} for c in classes})
    views.update({("activity", a): {} for a in activities})

    for rel, props, _ in notes:
        kind, share = props.get("type"), share_of(props)
        is_me = rel == Path("Me.md")
        if kind == "guide":
            continue  # AGENTS.md: rules for agents, not about the student
        if kind == "person" and not is_me and props.get("role") == "student":
            continue  # classmates: another student's information, never in a view
        if "private" in share and kind not in CANT_HIDE:
            continue
        views[("parent", None)][rel] = is_me or kind in PARENT_SUMMARY
        # People/ notes go only to parents unless the student shares them.
        person = kind == "person" and not is_me
        links = linked_names(props)
        if "advisor" in share or (not person and (is_me or kind in ADVISOR_TYPES)):
            views[("advisor", None)][rel] = True
        for aud, names, own_type in (("teacher", classes, "class"),
                                     ("activity", activities, "activity")):
            # share: [teacher] reaches the teachers of the classes the note links,
            # or every teacher when it links none (same for activity leaders).
            to_all = aud in share and not any(n.lower() in links for n in names)
            for name in names:
                own = kind == own_type and rel.stem == name
                tagged = name.lower() in links and (aud in share or not person)
                if own or tagged or to_all:
                    views[(aud, name)][rel] = True
    return views


def view_path(root, audience, scope):
    return root / audience / scope if scope else root / audience


def build_views(locker, out):
    """Rebuild every view from scratch, then swap it in, so a note that is now
    private or untagged is gone from the views. Returns (plan, skipped, as_of)."""
    notes, skipped = load_notes(locker)
    plan = plan_views(notes)
    texts = {rel: text for rel, _, text in notes}
    kinds = {rel: p.get("type") for rel, p, _ in notes}
    as_of = now().isoformat(timespec="seconds")

    out.parent.mkdir(parents=True, exist_ok=True)
    new, old = out.with_name(out.name + ".new"), out.with_name(out.name + ".old")
    for leftover in (new, old):
        if leftover.exists():
            shutil.rmtree(leftover)
    new.mkdir(mode=0o700)
    for (audience, scope), entries in plan.items():
        folder = view_path(new, audience, scope)
        folder.mkdir(parents=True, exist_ok=True)
        for rel in sorted(entries):
            dest = folder / rel
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text(texts[rel], encoding="utf-8")
        manifest = {
            "format": VIEW_FORMAT, "audience": audience, "scope": scope, "as_of": as_of,
            "omalocker": VERSION,
            "notes": [{"path": rel.as_posix(), "type": kinds[rel], "summary": entries[rel]}
                      for rel in sorted(entries)],
        }
        (folder / "view.json").write_text(json.dumps(manifest, indent=2) + "\n")
    # Local only, never part of a view: which Locker these views came from.
    (new / ".omalocker.json").write_text(
        json.dumps({"locker": str(locker.resolve()), "as_of": as_of}) + "\n")
    if out.exists():
        os.replace(out, old)
    os.replace(new, out)
    if old.exists():
        shutil.rmtree(old)
    return plan, skipped, as_of


def read_view_files(folder):
    files = {}
    for root, _, names in os.walk(folder):
        for name in names:
            path = Path(root, name)
            rel = path.relative_to(folder)
            if rel != Path("view.json"):
                files[rel] = path
    return files


def views_problem(locker):
    """(leak, stale) lines for doctor about this Locker's views, or (None, None).
    leak: a view holds a note its audience can't see now. stale: out of date."""
    out = views_dir()
    try:
        meta = json.loads((out / ".omalocker.json").read_text())
    except (OSError, ValueError):
        return None, None
    if Path(meta.get("locker", "")) != locker.resolve():
        return None, None
    notes, _ = load_notes(locker)
    try:
        plan = plan_views(notes)
    except ViewError:
        plan = {}
    texts = {rel: text for rel, _, text in notes}
    expected = {view_path(out, a, s): entries for (a, s), entries in plan.items()}
    built = [Path(r) for r, _, names in os.walk(out) if "view.json" in names]
    leaked, stale = 0, False
    for folder in built:
        entries = expected.get(folder)
        files = read_view_files(folder)
        if entries is None:
            leaked += len(files)  # a view for an audience that's gone
            continue
        for rel, path in files.items():
            if rel not in entries:
                leaked += 1
            elif path.read_text(encoding="utf-8", errors="replace") != texts[rel]:
                stale = True
        if set(entries) - set(files):
            stale = True
    if set(expected) - set(built):
        stale = True
    leak = (f"views hold {leaked} note{'s' if leaked != 1 else ''} their audience can't "
            "see now: run `omalocker views`") if leaked else None
    return leak, (f"views are older than the notes (as of {meta.get('as_of')}): "
                  "run `omalocker views`" if stale and not leak else None)


def cmd_views(args):
    locker = Path(args.locker or default_locker()).expanduser()
    if not locker.is_dir():
        print(f"omalocker: no Locker at {locker}", file=sys.stderr)
        return 1
    out = Path(args.out).expanduser() if args.out else views_dir()
    if out.resolve() == locker.resolve() or locker.resolve() in out.resolve().parents:
        print("omalocker: views go outside the Locker", file=sys.stderr)
        return 1
    try:
        plan, skipped, as_of = build_views(locker, out)
    except ViewError as e:
        print(f"omalocker: {e}", file=sys.stderr)
        return 1
    print(f"Views as of {as_of} in {out}")
    for (audience, scope), entries in plan.items():
        label = f"{audience}: {scope}" if scope else audience
        summary = sum(entries.values())
        extra = f" ({summary} on the first page)" if audience == "parent" else ""
        print(f"  {label}: {len(entries)} notes{extra}")
    if skipped:
        print(f"  {skipped} note{'s' if skipped > 1 else ''} left out of every view: "
              "frontmatter can't be read (run `omalocker doctor`)")
    return 0


def viewer_config():
    """{url, token_file} for pushing views, or None when not set up."""
    if os.environ.get("OMALOCKER_VIEWER_CONFIG"):
        paths = [Path(os.environ["OMALOCKER_VIEWER_CONFIG"])]
    else:
        config_home = Path(os.environ.get("XDG_CONFIG_HOME") or home() / ".config")
        paths = [config_home / "omalocker" / "viewer.toml", Path("/etc/omalocker/viewer.toml")]
    for path in paths:
        if path.exists():
            with open(path, "rb") as f:
                cfg = tomllib.load(f)
            if not cfg.get("url") or not cfg.get("token_file"):
                raise ViewError(f"{path} needs url and token_file")
            return cfg
    return None


# A push bigger than this goes in parts (Vercel takes at most 4.5 MB per request).
PUSH_PART_BYTES = 3 * 1024 * 1024


def viewer_call(cfg, path, payload=None):
    """POST payload (or GET when None) to the viewer with this laptop's token."""
    import urllib.error
    import urllib.request
    base = str(cfg["url"]).rstrip("/")
    parts = urllib.parse.urlsplit(base)
    if parts.scheme != "https" and parts.hostname not in ("localhost", "127.0.0.1", "::1"):
        raise ViewError("the viewer url must be https:// (student data never goes out unencrypted)")
    token = Path(str(cfg["token_file"])).expanduser().read_text().strip()
    body = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(base + path, data=body,
                                 method="POST" if body is not None else "GET",
                                 headers={"Authorization": f"Bearer {token}",
                                          "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("error")
        except ValueError:
            msg = None
        raise ViewError(f"the viewer said {e.code}: {msg or e.reason}")
    except urllib.error.URLError as e:
        raise ViewError(f"can't reach the viewer: {e.reason}")


def push_views(cfg, out):
    limit = int(os.environ.get("OMALOCKER_PUSH_PART_BYTES") or PUSH_PART_BYTES)

    def post(path, payload):
        return viewer_call(cfg, path, payload)

    views = []
    for manifest_path in sorted(out.rglob("view.json")):
        folder = manifest_path.parent
        manifest = json.loads(manifest_path.read_text())
        for n in manifest["notes"]:
            n["text"] = (folder / n["path"]).read_text(encoding="utf-8")
        views.append(manifest)
    whole = {"format": VIEW_FORMAT, "views": views}
    if len(json.dumps(whole).encode()) <= limit:
        return {**post("/api/push", whole), "parts": 1}

    # Too big for one request: begin, send notes in parts, then commit with counts.
    upload = post("/api/push/begin", {})["upload"]
    header = lambda v: {k: v[k] for k in ("audience", "scope", "as_of")}
    sent, batch, size = 0, {}, 0

    def flush():
        nonlocal batch, size, sent
        if batch:
            post("/api/push/part", {"upload": upload, "views": list(batch.values())})
            sent += 1
        batch, size = {}, 0

    for v in views:
        for n in v["notes"]:
            note = {k: n[k] for k in ("path", "type", "summary", "text")}
            cost = len(json.dumps(note).encode()) + 200
            if size and size + cost > limit:
                flush()
            key = (v["audience"], v["scope"])
            batch.setdefault(key, {**header(v), "notes": []})["notes"].append(note)
            size += cost
    flush()
    result = post("/api/push/commit", {"upload": upload, "views": [
        {**header(v), "count": len(v["notes"])} for v in views]})
    return {**result, "parts": sent}


def cmd_push(args):
    # --if-set-up (the hourly timer): a laptop with nothing to push isn't an error.
    quiet = 0 if args.if_set_up else 1
    locker = Path(args.locker or default_locker()).expanduser()
    if not locker.is_dir():
        print(f"omalocker: no Locker at {locker}", file=sys.stderr)
        return quiet
    done = graduated()
    if done:
        print(f"omalocker: this Locker graduated on {done['graduated'][:10]}; "
              "views aren't sent any more", file=sys.stderr)
        return quiet
    if args.if_set_up:
        try:
            me, _ = read_note(locker / "Me.md")
        except (OSError, FormatError):
            me = None
        if (me or {}).get("role") != "student":
            print("omalocker: not a student's Locker; nothing to push")
            return 0
    try:
        cfg = viewer_config()
        if cfg is None:
            print("omalocker: the viewer isn't set up on this device "
                  "(/etc/omalocker/viewer.toml; see docs/viewer.md)", file=sys.stderr)
            return quiet
        out = views_dir()
        _, skipped, as_of = build_views(locker, out)
        result = push_views(cfg, out)
    except (ViewError, OSError) as e:
        print(f"omalocker: {e}", file=sys.stderr)
        return 1
    parts = f" in {result['parts']} parts" if result.get("parts", 1) > 1 else ""
    print(f"Pushed {result['views']} views ({result['notes']} notes) as of {as_of}{parts}")
    if skipped:
        print(f"  {skipped} note{'s' if skipped > 1 else ''} left out: frontmatter can't be read "
              "(run `omalocker doctor`)")
    return 0


# ---------------------------------------------------------------- levels
#
# Teacher -> student. `send-levels` (teacher's laptop) reads each class's plan files,
# mastery.csv and the ids in roster.toml, and sends every student's latest levels
# keyed by school id: names stay in memory and never leave the laptop. The viewer
# keeps only students the teacher has a grant for in that class. `pull-levels`
# (student's laptop) writes the student's own levels into Mastery/<class>.md.

def read_roster_ids(folder):
    """{student name: {"blackbaud_id", "canvas_id"}} from roster.toml. Names are only keys."""
    path = folder / "roster.toml"
    if not path.exists():
        return {}
    ids = {}
    for s in load_toml(path).get("student", []):
        name = str(s.get("name") or "").strip()
        if name:
            ids[name] = {k: (str(s[k]) if s.get(k) not in (None, "") else None)
                         for k in ("blackbaud_id", "canvas_id")}
    return ids


def student_levels(c, levels):
    """{student: {"ideas": [...], "objectives": [...]}} from a class and its latest levels.
    A core idea's level is the student's lowest on its objectives (as in `mastery`)."""
    ideas = {note_name(i["name"]): i for i in c["ideas"]}
    objectives = [o for o in c["objectives"] if o.get("id")]
    for o in objectives:
        if o.get("idea") and note_name(o["idea"]) not in ideas:
            ideas[note_name(o["idea"])] = {"name": o["idea"]}
    students = {s for per in levels.values() for s in per}
    out = {}
    for s in students:
        objs, by_idea = [], {}
        for o in sorted(objectives, key=lambda o: str(o.get("week", ""))):
            level = levels.get(o["id"], {}).get(s)
            if level is None:
                continue
            idea = note_name(o["idea"]) if o.get("idea") else None
            objs.append({"id": str(o["id"]), "title": str(o.get("title") or o["id"]),
                         "idea": idea, "week": str(o.get("week") or ""), "level": LEVELS[level]})
            if idea:
                by_idea[idea] = min(level, by_idea.get(idea, level))
        out[s] = {"ideas": [{"name": n, "joint": note_name(ideas[n]["joint"]) if ideas[n].get("joint") else None,
                             "level": LEVELS[lv]} for n, lv in by_idea.items()],
                  "objectives": objs}
    return out


def locker_role(locker):
    try:
        me, _ = read_note(locker / "Me.md")
    except (OSError, FormatError, UnicodeDecodeError):
        return None
    return (me or {}).get("role")


def canvas_url():
    """The school's Canvas address, where OmaMastery keeps it (connect.toml)."""
    if os.environ.get("OMALOCKER_CANVAS_URL"):
        return os.environ["OMALOCKER_CANVAS_URL"].rstrip("/")
    config_home = Path(os.environ.get("XDG_CONFIG_HOME") or home() / ".config")
    for path in (config_home / "omamastery" / "connect.toml", Path("/etc/omamastery/connect.toml")):
        try:
            url = str(load_toml(path).get("canvas_url") or "").rstrip("/")
        except (OSError, tomllib.TOMLDecodeError):
            continue
        if url.startswith("https://"):
            return url
    return None


def class_assignments(c, base):
    """The class's Canvas assignments, from plan.toml objectives that name one."""
    out = []
    for o in sorted(c["objectives"], key=lambda o: str(o.get("week", ""))):
        aid = str(o.get("canvas_assignment") or "").strip()
        if not aid:
            continue
        url = (f"{base}/courses/{c['canvas_course']}/assignments/{aid}"
               if base and c.get("canvas_course") and aid.isdigit() else None)
        out.append({"id": aid, "title": str(o.get("title") or aid), "week": str(o.get("week") or ""),
                    "idea": note_name(o["idea"]) if o.get("idea") else None, "url": url})
    return out


def cmd_send_levels(args):
    quiet = 0 if args.if_set_up else 1
    locker = Path(args.locker or default_locker()).expanduser()
    classes_dir = Path(args.classes or home() / "Classes").expanduser()
    try:
        cfg = viewer_config()
    except ViewError as e:
        print(f"omalocker: {e}", file=sys.stderr)
        return 1
    if args.if_set_up and locker_role(locker) != "teacher":
        print("omalocker: not a teacher's Locker; no levels to send")
        return 0
    if cfg is None:
        print("omalocker: the viewer isn't set up on this device "
              "(/etc/omalocker/viewer.toml; see docs/viewer.md)", file=sys.stderr)
        return quiet
    if not classes_dir.is_dir():
        print(f"omalocker: no classes folder at {classes_dir}", file=sys.stderr)
        return quiet
    by_id = class_notes_by_id(locker / "Classes") if (locker / "Classes").is_dir() else {}
    base = canvas_url()
    classes, no_id = [], 0
    for c in read_classes(classes_dir):
        if c["sample"]:
            continue  # OmaMastery's sample classes have made-up students
        try:
            levels, as_of = read_levels(c["path"])
            ids = read_roster_ids(c["path"])
        except (OSError, UnicodeDecodeError, csv.Error, tomllib.TOMLDecodeError) as e:
            print(f"  skipped {c['id']}: can't read it ({e.__class__.__name__})", file=sys.stderr)
            continue
        students = []
        for name, data in student_levels(c, levels).items():
            sid = ids.get(name) or {}
            if not (sid.get("blackbaud_id") or sid.get("canvas_id")):
                no_id += 1
                continue
            students.append({**sid, **data})
        info = {"course": c["name"], "room": c["room"],
                "block": None if c["block"] is None else str(c["block"]), "day": c["day"],
                "assignments": class_assignments(c, base)}
        classes.append({"class": by_id.get(c["id"]) or note_name(c["name"]),
                        "as_of": as_of or "", "info": info, "students": students})
    if not classes:
        print("omalocker: no classes with levels to send")
        return 0
    try:
        r = viewer_call(cfg, "/api/levels", {"classes": classes})
    except (ViewError, OSError) as e:
        print(f"omalocker: {e}", file=sys.stderr)
        return 1
    print(f"Sent levels for {r['classes']} classes: {r['students']} students stored")
    if r["unmatched"]:
        print(f"  {r['unmatched']} not matched to a student in the viewer (no Blackbaud or "
              "Canvas id on file there)")
    if r["not_yours"]:
        print(f"  {r['not_yours']} matched a student you have no teacher grant for in that class")
    if no_id:
        print(f"  {no_id} students have no Blackbaud or Canvas id in the roster; run "
              "OmaMastery setup to refresh it")
    return 0


def mastery_block(c, locker):
    def idea_cell(name):
        if name and (locker / "Ideas" / f"{note_name(name)}.md").exists():
            return link(note_name(name))
        return name or ""
    lines = ["| Core idea | Latest level |", "|---|---|"]
    lines += [f"| {idea_cell(i['name'])} | {i['level']} |" for i in c.get("ideas", [])]
    if c.get("objectives"):
        lines += ["", "| Learning target | Core idea | Level |", "|---|---|---|"]
        lines += [f"| {o['title'].replace('|', '/')} | {idea_cell(o.get('idea'))} | {o['level']} |"
                  for o in c["objectives"]]
    return "\n".join(lines)


def class_note_from_teacher(locker, cls, c):
    """The student's Classes/<class>.md: room, block and day as the teacher's OmaMastery
    (and OmaClass) have them. Only these properties and the import's block are rewritten."""
    info = c.get("info") or {}
    owned = {"type": "class", "course": info.get("course") or cls, "room": info.get("room"),
             "source": SOURCE}
    if info.get("block") not in (None, ""):
        owned["block"] = int(info["block"]) if str(info["block"]).isdigit() else info["block"]
    if info.get("day"):
        owned["day"] = info["day"]
    teacher = note_name(c.get("teacher") or "")
    if teacher and (locker / "People" / f"{teacher}.md").exists():
        owned["teacher"] = link(teacher)
    ideas = [note_name(i["name"]) for i in c.get("ideas", []) if i.get("name")]
    shown = [link(i) if (locker / "Ideas" / f"{i}.md").exists() else i for i in ideas]
    block = "Core ideas: " + (", ".join(shown) + "." if shown else "none yet.")
    return upsert(locker / "Classes" / f"{cls}.md", owned, block, cls, tail="\n## My notes\n")


def work_stubs_from_teacher(locker, cls, c):
    """A work note per Canvas assignment in Work/<class>/. Never overwrites the student's
    work: an existing note (found by its Canvas link, then by title) only gets its
    canvas_assignment and the app's block refreshed. Returns how many notes changed."""
    folder = locker / "Work" / cls
    assignments = (c.get("info") or {}).get("assignments") or []
    by_link = {}
    if folder.is_dir():
        for path in folder.glob("*.md"):
            try:
                props, _ = read_note(path)
            except (FormatError, UnicodeDecodeError):
                continue
            if (props or {}).get("canvas_assignment"):
                by_link[str(props["canvas_assignment"])] = path
    changed = 0
    for a in assignments:
        title = note_name(str(a.get("title") or a.get("id") or "Assignment"))
        url = a.get("url")
        path = by_link.get(url) if url else None
        path = path or folder / f"{title}.md"
        week = f", week of {a['week']}" if a.get("week") else ""
        where = f": {url}" if url else ""
        block = f"Canvas assignment{week}{where}"
        if path.exists():
            try:
                props, body = read_note(path)
            except (FormatError, UnicodeDecodeError):
                continue
            props = props or {}
            if props.get("type") not in (None, "work"):
                continue
            if url:
                props["canvas_assignment"] = url
        else:
            props = {"type": "work", "class": link(cls), "status": "idea"}
            if a.get("idea") and (locker / "Ideas" / f"{a['idea']}.md").exists():
                props["ideas"] = [link(a["idea"])]
            props["canvas_assignment"] = url
            body = f"# {title}\n"
        body = set_block(body, "canvas", block)
        if write_if_changed(path, dump_props(props) + body):
            changed += 1
    return changed


def cmd_pull_levels(args):
    quiet = 0 if args.if_set_up else 1
    locker = Path(args.locker or default_locker()).expanduser()
    if graduated():
        print("omalocker: this Locker graduated; levels aren't pulled any more", file=sys.stderr)
        return quiet
    if locker_role(locker) != "student":
        print("omalocker: not a student's Locker; no levels to pull")
        return quiet
    try:
        cfg = viewer_config()
        if cfg is None:
            print("omalocker: the viewer isn't set up on this device "
                  "(/etc/omalocker/viewer.toml; see docs/viewer.md)", file=sys.stderr)
            return quiet
        got = viewer_call(cfg, "/api/levels")
    except (ViewError, OSError) as e:
        print(f"omalocker: {e}", file=sys.stderr)
        return 1
    changed = 0
    for c in got.get("classes", []):
        cls = note_name(str(c.get("class") or ""))
        if class_note_from_teacher(locker, cls, c) in ("created", "updated"):
            changed += 1
        changed += work_stubs_from_teacher(locker, cls, c)
        path = locker / "Mastery" / f"{cls}.md"
        owned = {"type": "mastery", "class": link(cls), "source": SOURCE,
                 "as_of": c.get("as_of") or None}
        if path.exists():
            try:
                props, body = read_note(path)
            except (FormatError, UnicodeDecodeError):
                print(f"  skipped Mastery/{cls}.md: frontmatter can't be read", file=sys.stderr)
                continue
            props = props or {}
        else:
            teacher = c.get("teacher") or "your teacher"
            props, body = {}, (f"# {cls}: mastery\n\nFrom {teacher}. Read-only: changes come "
                               "from the teacher.\n")
        props.update(owned)
        body = set_block(body, SOURCE, mastery_block(c, locker))
        if write_if_changed(path, dump_props(props) + body):
            changed += 1
    print(f"Levels, class details and assignments for {len(got.get('classes', []))} classes; "
          f"{changed} notes changed")
    return 0


# ---------------------------------------------------------------- turn in
#
# Omacanvas turns in writing from a file. A Locker work note is more than the writing:
# properties, [[links]], %% comments %%, app blocks. `submission` gives Omacanvas just
# the writing; `turned-in` records the turn-in on the note (docs/omacanvas.md).

ASSIGNMENT_URL = re.compile(r"^https://[^/\s]+/courses/\d+/assignments/\d+/?$")
EMBED_RE = re.compile(r"!\[\[[^\]]*\]\]")
COMMENT_RE = re.compile(r"%%.*?%%", re.S)
BLOCK_FULL_RE = re.compile(r"<!-- omalocker:([\w-]+) -->.*?<!-- /omalocker:\1 -->\n?", re.S)


def submission_text(text):
    """The writing in a note, as a teacher should see it."""
    try:
        _, body = split_note(text)
    except FormatError:
        body = text
    body = COMMENT_RE.sub("", body)              # Obsidian comments: never for the teacher
    body = BLOCK_FULL_RE.sub("", body)           # app-made blocks aren't the student's writing
    body = EMBED_RE.sub("", body)                # embedded notes and images can't go as text
    body = LINK_RE.sub(lambda m: (m.group(0).split("|", 1)[1][:-2] if "|" in m.group(0)
                                  else m.group(1)).strip(), body)
    body = re.sub(r"[ \t]+\n", "\n", body)
    return re.sub(r"\n{3,}", "\n\n", body).strip() + "\n"


def work_note(locker, path):
    """(resolved path, props, body) of a work note inside the Locker, or exit."""
    path = Path(path).expanduser().resolve()
    if locker.resolve() not in path.parents:
        sys.exit(f"omalocker: {path} isn't in the Locker ({locker})")
    try:
        props, body = read_note(path)
    except (OSError, FormatError, UnicodeDecodeError) as e:
        sys.exit(f"omalocker: can't read {path.name}: {e}")
    return path, props or {}, body


def cmd_submission(args):
    path = Path(args.note).expanduser()
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as e:
        print(f"omalocker: can't read {path}: {e}", file=sys.stderr)
        return 1
    out = submission_text(text)
    if not out.strip():
        print("omalocker: nothing to turn in: the note has no writing yet", file=sys.stderr)
        return 1
    sys.stdout.write(out)
    return 0


def cmd_turned_in(args):
    locker = Path(args.locker or default_locker()).expanduser()
    path, props, body = work_note(locker, args.note)
    if props.get("type") != "work":
        print(f"omalocker: {path.name} isn't a work note (type: {props.get('type')})", file=sys.stderr)
        return 1
    if args.assignment and not ASSIGNMENT_URL.match(args.assignment):
        print("omalocker: --assignment must be a Canvas assignment link, like "
              "https://school.instructure.com/courses/12/assignments/34", file=sys.stderr)
        return 1
    props["status"] = "turned-in"
    if args.assignment:
        props["canvas_assignment"] = args.assignment.rstrip("/")
    result = write_if_changed(path, dump_props(props) + body)
    print(f"{path.relative_to(locker.resolve())}: turned in" + ("" if result else " (already marked)"))
    return 0


# ---------------------------------------------------------------- graduate
#
# At graduation the student keeps their Locker and the school deletes its
# copies (decision 6): hand over the Locker first, then this device stops
# pushing and backing up, then the viewer and backups are deleted
# (docs/graduation.md).

def graduated_path():
    state_home = Path(os.environ.get("XDG_STATE_HOME") or home() / ".local" / "state")
    return state_home / "omalocker" / "graduated.json"


def graduated():
    try:
        return json.loads(graduated_path().read_text())
    except (OSError, ValueError):
        return None


def export_excluded(rel):
    import fnmatch
    posix = rel.as_posix()
    return any(fnmatch.fnmatch(posix, pat) or fnmatch.fnmatch(rel.name, pat)
               or posix.startswith(pat + "/") for pat in BACKUP_EXCLUDES)


def export_locker(locker, zip_path):
    """Zip the whole Locker into zip_path and read it back. Returns the file count."""
    import zipfile
    files = []
    for root, dirs, names in os.walk(locker):
        dirs.sort()
        for name in sorted(names):
            path = Path(root, name)
            rel = path.relative_to(locker)
            if path.is_symlink() or export_excluded(rel):
                continue
            files.append(rel)
    tmp = zip_path.with_name(f".{zip_path.name}.omalocker-tmp")
    try:
        with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as z:
            for rel in files:
                z.write(locker / rel, (Path("Locker") / rel).as_posix())
        with zipfile.ZipFile(tmp) as z:
            if z.testzip() is not None or len(z.namelist()) != len(files):
                raise OSError("the export didn't read back complete")
        os.replace(tmp, zip_path)
    finally:
        tmp.unlink(missing_ok=True)
    return len(files)


def cmd_graduate(args):
    locker = Path(args.locker or default_locker()).expanduser().resolve()
    if not (locker / "Me.md").exists():
        print(f"omalocker: no Locker at {locker}", file=sys.stderr)
        return 1
    try:
        me, _ = read_note(locker / "Me.md")
    except FormatError as e:
        print(f"omalocker: Me.md: {e}", file=sys.stderr)
        return 1
    if (me or {}).get("role") != "student":
        print("omalocker: graduate is for a student's Locker (Me.md role: student)",
              file=sys.stderr)
        return 1
    out = Path(args.to).expanduser().resolve()
    if out == locker or locker in out.parents:
        print("omalocker: put the export outside the Locker", file=sys.stderr)
        return 1
    out.mkdir(parents=True, exist_ok=True)
    zip_path = out / f"Locker {now().astimezone().date().isoformat()}.zip"
    if zip_path.exists():
        print(f"omalocker: {zip_path} already exists; nothing written over it", file=sys.stderr)
        return 1
    try:
        count = export_locker(locker, zip_path)
    except OSError as e:
        print(f"omalocker: export failed, nothing changed: {e}", file=sys.stderr)
        return 1

    first = graduated()
    path = graduated_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({
        "graduated": (first or {}).get("graduated") or now().isoformat(timespec="seconds"),
        "locker": str(locker), "export": str(zip_path), "files": count}, indent=2) + "\n")
    if views_dir().exists():
        shutil.rmtree(views_dir())  # local copies of the views; the Locker stays
    print(f"Exported the Locker ({count} files) to {zip_path}")
    print("  This device no longer pushes views or makes backups.")
    print("  Next (docs/graduation.md):")
    print("    1. Give the student the zip and check they can open it.")
    print("    2. Viewer admin: omalocker-viewer graduate <student email> --yes")
    print("    3. School IT: delete this student's backup repository on school storage.")
    return 0


# ---------------------------------------------------------------- doctor

def is_class_folder(path):
    return (path / "class.toml").exists() or path.name == "archive"


def locker_files(locker):
    """(notes to check, every file name for link resolution)."""
    notes, everything = [], []
    for root, dirs, files in os.walk(locker):
        root = Path(root)
        rel_root = root.relative_to(locker)
        in_classes = rel_root.parts[:1] == ("Classes",)
        skip_here = in_classes and len(rel_root.parts) > 1
        dirs[:] = sorted(d for d in dirs if not d.startswith("."))
        for f in sorted(files):
            if f.startswith(".") and f.endswith(".omalocker-tmp"):
                continue
            rel = rel_root / f
            everything.append(rel)
            if not f.endswith(".md") or f.startswith("."):
                continue
            if skip_here and is_class_folder(locker / Path(*rel_root.parts[:2])):
                continue  # OmaMastery's own files: never opened
            if in_classes and len(rel_root.parts) == 1 and f in ("AGENTS.md", "CLAUDE.md"):
                continue  # OmaMastery's agent guide
            notes.append(rel)
    return notes, everything


def link_index(files):
    stems, paths = set(), set()
    for rel in files:
        p = rel.as_posix().lower()
        if p.endswith(".md"):
            stems.add(rel.stem.lower())
            paths.add(p[:-3])
        else:
            stems.add(rel.name.lower())
            paths.add(p)
    return stems, paths


def resolves(target, index):
    stems, paths = index
    t = target.strip().lower().lstrip("/")
    if t.endswith(".md"):
        t = t[:-3]
    if not t:
        return True  # [[#heading]] in the same note
    return t in stems or t in paths or any(p.endswith("/" + t) for p in paths)


def check_note(rel, text, index):
    problems, broken = [], []
    try:
        lines, body = split_note(text)
        if lines is None:
            return ["no frontmatter (needs at least a type)"], [], {}
        props = parse_props(lines)
    except FormatError as e:
        return [f"frontmatter: {e}"], [], {}
    kind = props.get("type")
    folder = rel.parts[0] if len(rel.parts) > 1 else ""
    if not kind:
        problems.append("no type")
    elif kind not in TYPES:
        problems.append(f"unknown type {kind!r}")

    share = props.get("share")
    if "share" in props:
        if not isinstance(share, list):
            problems.append("share must be a list, like [private] or [parent, teacher]")
        else:
            bad = [s for s in share if s not in AUDIENCES]
            if bad:
                problems.append(f"share has unknown audience {', '.join(map(str, bad))}")
            if "private" in share and len(share) > 1:
                problems.append("share: private can't be combined with other audiences")
            if "private" in share and kind in CANT_HIDE:
                problems.append(f"share: [private] doesn't hide a {kind} note from parents")
    if "private" in props:
        problems.append("private: true is replaced by share: [private]")

    if kind == "journal" and not (folder == "Journal"
                                  and re.fullmatch(r"\d{4}-\d{2}-\d{2}", rel.stem)):
        problems.append("journal notes go in Journal/ as YYYY-MM-DD.md")
    if kind == "milestone" and not (rel.parent.as_posix() == "Pathway/Milestones"
                                    and re.match(r"\d{4}-\d{2}-\d{2} ", rel.name)):
        problems.append("milestones go in Pathway/Milestones/ as YYYY-MM-DD <name>.md")
    if kind in ("mastery", "objective") and folder != "Mastery":
        problems.append(f"{kind} notes go in Mastery/")
    if kind == "objective" and props.get("level") and props["level"] not in LEVELS:
        problems.append(f"level {props['level']!r} isn't one of {', '.join(LEVELS)}")
    if kind == "home" and rel != Path("Home.md"):
        problems.append("type home is only for Home.md")
    if kind == "guide" and rel.name != "AGENTS.md":
        problems.append("type guide is only for AGENTS.md")
    if kind == "person" and props.get("role") and props["role"] not in ROLES:
        problems.append(f"role {props['role']!r} isn't one of {', '.join(sorted(ROLES))}")
    if kind == "work" and props.get("status") and props["status"] not in WORK_STATUS:
        problems.append(f"status {props['status']!r} isn't one of {', '.join(sorted(WORK_STATUS))}")
    if kind == "class" and props.get("day") and props["day"] not in ("A", "B"):
        problems.append("day must be A or B")

    open_block = None
    for m in BLOCK_RE.finditer(body):
        closing, name = m.group(1) == "/", m.group(2)
        if not closing:
            if open_block:
                problems.append(f"omalocker:{name} block starts inside omalocker:{open_block}")
            open_block = name
        elif open_block != name:
            problems.append(f"/omalocker:{name} closes a block that isn't open")
        else:
            open_block = None
    if open_block:
        problems.append(f"omalocker:{open_block} block is never closed")

    values = []
    for v in props.values():
        values.extend(v if isinstance(v, list) else [v])
    prose = CODE_RE.sub("", FENCE_RE.sub("", body))
    targets = [t for t in (link_target(v) for v in values if v) if t is not None]
    targets += [m.group(1).rstrip("\\") for m in LINK_RE.finditer(prose)]
    for t in targets:
        if not resolves(t, index):
            broken.append(t)
    return problems, broken, props


def cmd_doctor(args):
    locker = Path(args.locker or default_locker()).expanduser()
    if not locker.is_dir():
        print(f"omalocker: no Locker at {locker}", file=sys.stderr)
        return 1
    notes, everything = locker_files(locker)
    index = link_index(everything)
    report, hidden = [], 0
    for rel in notes:
        try:
            text = (locker / rel).read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as e:
            report.append({"note": str(rel), "problems": [f"can't read: {e.__class__.__name__}"],
                           "broken_links": []})
            continue
        problems, broken, props = check_note(rel, text, index)
        if not problems and not broken:
            continue
        sensitive = rel.parts[0] == "People" or "private" in (props.get("share") or [])
        label = str(rel)
        if sensitive and not args.show_names:
            hidden += 1
            label = f"{rel.parts[0]}/(a note: names hidden)"
        entry = {"note": label, "problems": problems,
                 "broken_links": broken if args.show_names else len(broken)}
        report.append(entry)

    backup = backup_problem(locker)
    leak, stale = views_problem(locker)
    failed = bool(report or backup or leak)
    if args.json:
        print(json.dumps({"locker": str(locker), "notes": len(notes), "issues": report,
                          "backup": backup, "views": leak or stale}, indent=2))
        return 1 if failed else 0
    print(f"Checked {len(notes)} notes in {locker}")
    if backup:
        print(f"  backup: {backup}")
    if leak or stale:
        print(f"  views: {leak or stale}")
    done = graduated()
    if done:
        print(f"  graduated on {done['graduated'][:10]}; exported to {done.get('export')}")
    if not report:
        print("  all good: every note has a type, valid frontmatter, and links that resolve")
        return 1 if failed else 0
    for entry in report:
        print(f"\n  {entry['note']}")
        for p in entry["problems"]:
            print(f"    - {p}")
        b = entry["broken_links"]
        if isinstance(b, list):
            for t in b:
                print(f"    - link to [[{t}]] doesn't resolve")
        elif b:
            print(f"    - {b} link{'s' if b > 1 else ''} don't resolve")
    if not args.show_names:
        print("\n  Link targets and People/ notes are hidden because they can be names."
              "\n  `omalocker doctor --show-names` shows them; don't paste that output anywhere.")
    print(f"\n  {len(report)} note{'s' if len(report) > 1 else ''} to fix")
    return 1


# ---------------------------------------------------------------- main

def main(argv=None):
    parser = argparse.ArgumentParser(prog="omalocker", description=__doc__.split("\n")[0])
    parser.add_argument("--version", action="version", version=f"omalocker {VERSION}")
    parser.add_argument("--locker", help="Locker folder (default ~/Locker)")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("init", help="set up ~/Locker from the template; never overwrites")
    p.add_argument("--role", choices=sorted(ROLES),
                   help="fills in role on Me.md (default: role in /etc/omalocker/omalocker.toml)")
    p.add_argument("--move-classes", action="store_true",
                   help="move ~/Classes into the Locker and leave a link at ~/Classes")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("import", help="bring notes in from another app")
    p.add_argument("what", choices=["classes", "pacterminus"],
                   help="classes: OmaMastery classes and ideas; pacterminus: finishing the game "
                        "becomes a milestone")
    p.add_argument("--classes", help="OmaMastery folder (default ~/Classes)")
    p.set_defaults(func=cmd_import)

    p = sub.add_parser("mastery", help="mastery graph per class: Mastery/ notes and graph.html")
    p.add_argument("--classes", help="OmaMastery folder (default ~/Classes)")
    p.set_defaults(func=cmd_mastery)

    p = sub.add_parser("backup", help="encrypted backup of the Locker (restic)")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--if-due", action="store_true", help="only when the last good backup is due")
    g.add_argument("--status", action="store_true", help="last backup and snapshot count")
    p.set_defaults(func=cmd_backup)

    p = sub.add_parser("restore", help="restore the Locker from backup; never overwrites")
    p.add_argument("--to", help="folder to restore into (must be new or empty)")
    p.add_argument("--snapshot", help="snapshot id (default: the newest)")
    p.set_defaults(func=cmd_restore)

    p = sub.add_parser("views", help="build each audience's view of a student's Locker")
    p.add_argument("--out", help="views folder (default ~/.local/state/omalocker/views)")
    p.set_defaults(func=cmd_views)

    p = sub.add_parser("push", help="build the views and send them to the viewer")
    p.add_argument("--if-set-up", action="store_true",
                   help="for the timer: do nothing (and don't fail) on a laptop that has "
                        "no viewer settings, isn't a student's, or has graduated")
    p.set_defaults(func=cmd_push)

    p = sub.add_parser("send-levels", help="teacher: send each class's levels to the viewer "
                                          "(by school id; names stay here)")
    p.add_argument("--classes", help="OmaMastery folder (default ~/Classes)")
    p.add_argument("--if-set-up", action="store_true",
                   help="for the timer: do nothing on a laptop that isn't a teacher's or has "
                        "no viewer settings")
    p.set_defaults(func=cmd_send_levels)

    p = sub.add_parser("pull-levels", help="student: get your levels into Mastery/<class>.md")
    p.add_argument("--if-set-up", action="store_true",
                   help="for the timer: do nothing on a laptop that isn't a student's, has no "
                        "viewer settings, or has graduated")
    p.set_defaults(func=cmd_pull_levels)

    p = sub.add_parser("submission", help="print a note's writing as it should be turned in "
                                         "(no properties, comments or [[link]] brackets)")
    p.add_argument("note")
    p.set_defaults(func=cmd_submission)

    p = sub.add_parser("turned-in", help="mark a work note turned in (Omacanvas calls this)")
    p.add_argument("note")
    p.add_argument("--assignment", help="the Canvas assignment link")
    p.set_defaults(func=cmd_turned_in)

    p = sub.add_parser("graduate", help="hand the student their Locker; stop pushing and backups")
    p.add_argument("--to", required=True, help="folder for the Locker zip (e.g. a USB drive)")
    p.set_defaults(func=cmd_graduate)

    p = sub.add_parser("doctor", help="check frontmatter, types, blocks and links")
    p.add_argument("--show-names", action="store_true",
                   help="show People/ notes and link targets (can print real names)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_doctor)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
