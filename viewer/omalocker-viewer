def graduation_plan(db, student):
    """What graduating this student deletes: counts, and family logins that go with it."""
    sid = student["id"]
    count = lambda sql: db.execute(sql, (sid,)).fetchone()[0]
    family = db.execute(
        """SELECT p.* FROM people p WHERE p.is_student = 0 AND p.is_admin = 0
           AND EXISTS (SELECT 1 FROM grants g WHERE g.person_id = p.id
                       AND g.student_id = ? AND g.audience = 'parent')
           AND NOT EXISTS (SELECT 1 FROM grants g WHERE g.person_id = p.id
                           AND g.student_id != ?)""", (sid, sid)).fetchall()
    return {
        "views": count("SELECT COUNT(*) FROM views WHERE student_id = ?"),
        "notes": count("SELECT COUNT(*) FROM notes WHERE student_id = ?"),
        "grants": count("SELECT COUNT(*) FROM grants WHERE student_id = ?"),
        "push_token": count("SELECT COUNT(*) FROM push_tokens WHERE student_id = ?"),
        "audit": count("SELECT COUNT(*) FROM audit WHERE student_id = ?"),
        "family": family,
    }


def cmd_graduate(args):
    cfg, db = open_admin(args)
    student = person_by_email(db, args.email)
    if not student["is_student"]:
        raise ViewerError(f"{args.email} isn't a student")
    plan = graduation_plan(db, student)
    print(f"Graduating {student['name']} <{student['email']}> deletes:")
    print(f"  {plan['views']} views ({plan['notes']} notes), {plan['grants']} grants, "
          f"{'the' if plan['push_token'] else 'no'} push token, and their login")
    print(f"  {plan['audit']} access-log entries about them")
    for f in plan["family"]:
        print(f"  family login {f['name']} <{f['email']}> (no other student here)")
    print("  Teachers, advisors, leaders and family with another student here stay.")
    if not args.yes:
        print("Nothing deleted. Run again with --yes once the student has their Locker.")
        return 0
    db.execute("BEGIN IMMEDIATE")
    try:
        gone = [student["id"]] + [f["id"] for f in plan["family"]]
        marks = ",".join("?" * len(gone))
        logged = db.execute("DELETE FROM audit WHERE student_id = ?", (student["id"],)).rowcount
        db.execute(f"UPDATE audit SET actor = 'deleted #' || actor_id, detail = '' "
                   f"WHERE actor_id IN ({marks})", gone)
        emails = [student["email"]] + [f["email"] for f in plan["family"]]
        db.execute(f"UPDATE audit SET detail = '' WHERE detail IN "
                   f"({','.join('?' * len(emails))}) OR "
                   + " OR ".join("detail LIKE ?" for _ in emails),
                   [*emails, *[e + " %" for e in emails]])
        audit(db, cli_actor(), "graduate", detail=f"student #{student['id']}: views, logins, "
              f"records and {logged} access-log entries deleted")
        sid = student["id"]
        for table in ("notes", "views", "push_tokens"):
            db.execute(f"DELETE FROM {table} WHERE student_id = ?", (sid,))
        db.execute(f"DELETE FROM grants WHERE student_id = ? OR person_id IN ({marks})",
                   (sid, *gone))
        for table in ("sign_in", "sessions"):
            db.execute(f"DELETE FROM {table} WHERE person_id IN ({marks})", gone)
        db.execute(f"DELETE FROM people WHERE id IN ({marks})", gone)
        db.execute("COMMIT")
    except BaseException:
        db.execute("ROLLBACK")
        raise
    if not db.remote:
        db.execute("VACUUM")  # deleted rows shouldn't linger in the file
        db.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    print("Deleted.")
    return 0


def cmd_audit(args):
    cfg, db = open_admin(args)
    where, params = [], []
    if args.student:
        where.append("a.student_id = ?")
        params.append(person_by_email(db, args.student)["id"])
    if args.person:
        where.append("a.actor_id = ?")
        params.append(person_by_email(db, args.person)["id"])
    if args.since:
        import datetime
        try:
            since = datetime.datetime.fromisoformat(args.since)
        except ValueError:
            raise ViewerError("--since takes a date, like 2026-11-01")
        where.append("a.at >= ?")
        params.append(since.timestamp())
    if args.denied:
        where.append("a.result != 'ok'")
    sql = ("SELECT a.*, s.email AS student FROM audit a LEFT JOIN people s ON s.id = a.student_id"
           + (" WHERE " + " AND ".join(where) if where else "")
           + " ORDER BY a.at DESC, a.id DESC LIMIT ?")
    rows = db.execute(sql, (*params, args.limit)).fetchall()[::-1]
    import datetime

    def when(r):
        return datetime.datetime.fromtimestamp(r["at"]).astimezone().isoformat(timespec="seconds")

    if args.json:
        print(json.dumps([{"at": when(r), "actor": r["actor"], "action": r["action"],
                           "student": r["student"] or (f"#{r['student_id']}" if r["student_id"] else None),
                           "audience": r["audience"], "scope": r["scope"], "path": r["path"],
                           "result": r["result"], "detail": r["detail"]} for r in rows], indent=2))
        return 0
    for r in rows:
        student = r["student"] or (f"#{r['student_id']}" if r["student_id"] else "")
        view = r["audience"] + (f"/{r['scope']}" if r["scope"] else "")
        bits = [when(r), r["actor"], r["action"]]
        bits += [b for b in (student, view, r["path"]) if b]
        if r["result"] != "ok":
            bits.append(r["result"].upper())
        if r["detail"]:
            bits.append(f"({r['detail']})")
        print("  ".join(bits))
    if not rows:
        print("no entries")
    return 0


def cmd_list(args):
    cfg, db = open_admin(args)
    print(f"{cfg['env']} viewer at {cfg['base_url']}")
    for p in db.execute("SELECT * FROM people ORDER BY is_student DESC, name"):
        kind = "student" if p["is_student"] else ("admin" if p["is_admin"] else "person")
        print(f"  {p['id']:>4}  {kind:<8} {p['name']} <{p['email']}>")
    for g in db.execute(
            """SELECT p.email pe, s.email se, g.audience, g.scope, g.primary_custody FROM grants g
               JOIN people p ON p.id = g.person_id JOIN people s ON s.id = g.student_id
               ORDER BY se, g.audience, g.scope"""):
        extra = " primary custody" if g["primary_custody"] else ""
        scope = f" {g['scope']}" if g["scope"] else ""
        print(f"  grant {g['audience']}{scope}: {g['pe']} -> {g['se']}{extra}")
    return 0


def cmd_serve(args):
    server = make_server(db_target(args.data, args.db), args.host, args.port)
    cfg = server.RequestHandlerClass.viewer.cfg
    print(f"omalocker-viewer ({cfg['env']}) on http://{args.host}:{server.server_address[1]}",
          file=sys.stderr)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="omalocker-viewer", description=__doc__.split("\n")[0])
    parser.add_argument("--version", action="version", version=f"omalocker-viewer {VERSION}")
    parser.add_argument("--data", help="local data folder (default /var/lib/omalocker-viewer)")
    parser.add_argument("--db", help="Turso database URL (libsql://...; token in TURSO_AUTH_TOKEN). "
                                     "Default: OMALOCKER_VIEWER_DB or TURSO_DATABASE_URL, else --data")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("init", help="set up a viewer's data folder")
    p.add_argument("--env", choices=["staging", "production"])
    p.add_argument("--base-url", help="the address people open")
    p.add_argument("--timezone", default="America/Los_Angeles", help="how times are shown")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("person", help="add a person")
    psub = p.add_subparsers(dest="action", required=True)
    pa = psub.add_parser("add")
    pa.add_argument("--name", required=True)
    pa.add_argument("--email", required=True)
    pa.add_argument("--student", action="store_true")
    pa.add_argument("--grad-year", type=int)
    pa.add_argument("--admin", action="store_true")
    pa.set_defaults(func=cmd_person)

    for name, revoke in (("grant", False), ("revoke", True)):
        p = sub.add_parser(name, help=f"{name} a person's view of a student")
        p.add_argument("audience", choices=AUDIENCES)
        p.add_argument("--person", required=True, help="their email")
        p.add_argument("--student", required=True, help="the student's email")
        p.add_argument("--scope", help="class (teacher) or activity name, as in the Locker")
        if not revoke:
            p.add_argument("--primary-custody", action="store_true")
        p.set_defaults(func=lambda a, r=revoke: cmd_grant(a, revoke=r))

    p = sub.add_parser("sign-in-link", help="print a one-time sign-in link")
    p.add_argument("email")
    p.set_defaults(func=cmd_sign_in_link)

    p = sub.add_parser("push-token", help="make a student device's push token")
    p.add_argument("email")
    p.set_defaults(func=cmd_push_token)

    p = sub.add_parser("graduate", help="delete a graduated student's views, login and records")
    p.add_argument("email")
    p.add_argument("--yes", action="store_true", help="delete (without it: only list)")
    p.set_defaults(func=cmd_graduate)

    p = sub.add_parser("audit", help="access log: who opened what, and every change")
    p.add_argument("--student", help="entries about this student (email)")
    p.add_argument("--person", help="entries by this person (email)")
    p.add_argument("--since", help="from this date (YYYY-MM-DD)")
    p.add_argument("--denied", action="store_true", help="only refused or failed")
    p.add_argument("--limit", type=int, default=100, help="newest N (default 100)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_audit)

    p = sub.add_parser("list", help="people and grants")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("serve", help="run the viewer")
    p.add_argument("--host", default="127.0.0.1")
    p.add_argument("--port", type=int, default=8380)
    p.set_defaults(func=cmd_serve)

    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except ViewerError as e:
        print(f"omalocker-viewer: {e}", file=sys.stderr)
        return 1
    except sqlite3.Error as e:
        print(f"omalocker-viewer: database: {e}", file=sys.stderr)
        return 1
    finally:
        while _admin_dbs:
            _admin_dbs.pop().close()


if __name__ == "__main__":
    sys.exit(main())
