    ("mastery", "How it's going"), ("milestone", "Milestones"), ("pathway", "Goals"),
    ("class", "Classes"), ("work", "Work"), ("journal", "Journal"),
    ("activity", "Activities"), ("idea", "Big ideas"), ("joint", "Big ideas"),
    ("objective", "Learning targets"), ("person", "People"), ("home", "Home"),
    ("inbox", "Notes"),
]
SECTION_OF = dict(SECTIONS)
NEWEST_FIRST = {"milestone", "journal"}
# Properties that are bookkeeping, not something a reader needs.
HIDDEN_PROPS = {"type", "source", "share", "omamastery", "tags", "canvas_assignment", "scope"}
MONTHS = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split()


def esc(s):
    return html.escape(str(s))


def q(s):
    return urllib.parse.quote(str(s), safe="")


def view_url(student_id, audience, scope):
    return f"/s/{student_id}/{audience}/" + (f"{q(scope)}/" if scope else "")


def note_url(base, path):
    return f'{base}n/{"/".join(q(p) for p in path.split("/"))}'


def nice_date(value):
    m = re.match(r"(\d{4})-(\d{2})-(\d{2})", str(value or ""))
    if not m or not 1 <= int(m.group(2)) <= 12:
        return str(value or "")
    return f"{MONTHS[int(m.group(2)) - 1]} {int(m.group(3))}, {m.group(1)}"


def nice_time(cfg, iso):
    import datetime
    import zoneinfo
    try:
        when = datetime.datetime.fromisoformat(iso)
        when = when.astimezone(zoneinfo.ZoneInfo(cfg.get("timezone") or "America/Los_Angeles"))
    except (ValueError, TypeError, zoneinfo.ZoneInfoNotFoundError):
        return str(iso)
    hour = when.hour % 12 or 12
    return (f"{MONTHS[when.month - 1]} {when.day}, {when.year} at "
            f"{hour}:{when.minute:02d} {'AM' if when.hour < 12 else 'PM'}")


def link_name(value):
    m = LINK_RE.fullmatch(str(value).strip())
    return (m.group(2) or m.group(1)).strip() if m else str(value)


def note_title(path, kind):
    name = path.rsplit("/", 1)[-1].removesuffix(".md")
    if path == "Me.md":
        return "About me"
    if kind == "milestone":
        name = re.sub(r"^\d{4}-\d{2}-\d{2}\s+", "", name)
    if kind == "journal" and re.fullmatch(r"\d{4}-\d{2}-\d{2}", name):
        return nice_date(name)
    return name


def note_sub(kind, props, text):
    """One short line under a note's title, from its properties."""
    get = lambda k: props.get(k) if isinstance(props.get(k), str) else ""
    if kind == "class":
        bits = [link_name(get("teacher")) if get("teacher") else "",
                f"Room {get('room')}" if get("room") else "",
                f"Block {get('block')}{get('day')}" if get("block") else ""]
    elif kind in ("milestone", "pathway"):
        bits = [nice_date(get("date") or get("updated"))]
    elif kind == "work":
        bits = [f"Due {nice_date(get('due'))}" if get("due") else "",
                get("status").replace("-", " ")]
    elif kind == "activity":
        bits = [get("kind").capitalize(), get("season").capitalize()]
    else:
        bits = []
    return " · ".join(b for b in bits if b)


def mastery_levels(text):
    """[(core idea, level)] from a mastery note's table."""
    rows = []
    for line in text.split("\n"):
        cells = [c.strip() for c in line.strip().strip("|").split("|")] if line.strip().startswith("|") else []
        if len(cells) >= 2 and cells[-1] in ("Not yet", "Beginning", "Developing", "Proficient", "Extending"):
            rows.append((link_name(cells[0]), cells[-1]))
    return rows


