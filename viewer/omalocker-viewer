#!/usr/bin/env python3
"""omalocker-viewer: shows each person the views of a student's Locker they may see.

Python stdlib only (sqlite3 + http.server; put TLS in front, e.g. Caddy).
It stores views only, never the Locker itself: each student's device builds and
pushes them (`omalocker push`). Every page checks the signed-in person against
the student before showing anything. See docs/viewer.md.

  omalocker-viewer init --env staging|production --base-url URL
  omalocker-viewer person add --name NAME --email EMAIL [--student --grad-year Y] [--admin]
  omalocker-viewer grant parent|teacher|advisor|activity --person EMAIL --student EMAIL
                   [--scope CLASS_OR_ACTIVITY] [--primary-custody]
  omalocker-viewer revoke parent|teacher|advisor|activity --person EMAIL --student EMAIL [--scope X]
  omalocker-viewer sign-in-link EMAIL
  omalocker-viewer push-token STUDENT_EMAIL
  omalocker-viewer graduate STUDENT_EMAIL [--yes]
  omalocker-viewer list
  omalocker-viewer serve [--host 127.0.0.1] [--port 8380]
"""

