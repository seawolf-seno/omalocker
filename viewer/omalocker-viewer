# ---------------------------------------------------------------- storage
#
# Two backends with one interface (the parts of sqlite3 this file uses):
# a local SQLite file, or Turso (libSQL) over its HTTP API, for Vercel, where
# there is no lasting disk. Settings live in the database, so the Vercel
# function and the admin CLI read the same ones.

class Row:
    """A result row: row["name"] or row[0], like sqlite3.Row."""
    __slots__ = ("_cols", "_values")

    def __init__(self, cols, values):
        self._cols, self._values = cols, values

    def __getitem__(self, key):
        return self._values[key] if isinstance(key, int) else self._values[self._cols.index(key)]

    def keys(self):
        return list(self._cols)

    def __len__(self):
        return len(self._values)


class TursoCursor:
    def __init__(self, result):
        cols = [c.get("name") for c in result.get("cols", [])]
        self._rows = [Row(cols, [turso_value(v) for v in r]) for r in result.get("rows", [])]
        self.rowcount = result.get("affected_row_count", 0)
        rowid = result.get("last_insert_rowid")
        self.lastrowid = int(rowid) if rowid is not None else None

    def fetchone(self):
        return self._rows[0] if self._rows else None

    def fetchall(self):
        return list(self._rows)

    def __iter__(self):
        return iter(self._rows)


def turso_arg(v):
    if v is None:
        return {"type": "null"}
    if isinstance(v, (bool, int)):
        return {"type": "integer", "value": str(int(v))}
    if isinstance(v, float):
        return {"type": "float", "value": v}
    if isinstance(v, bytes):
        import base64
        return {"type": "blob", "base64": base64.b64encode(v).decode()}
    return {"type": "text", "value": str(v)}


def turso_value(v):
    kind = v.get("type")
    if kind == "integer":
        return int(v["value"])
    if kind == "float":
        return float(v["value"])
    if kind == "text":
        return v["value"]
    if kind == "blob":
        import base64
        return base64.b64decode(v.get("base64", ""))
    return None


class TursoConnection:
    """One Turso stream (an HTTP 'baton'), so BEGIN ... COMMIT spans requests."""
    remote = True

    def __init__(self, url, token):
        url = url.strip()
        if url.startswith("libsql://"):
            url = "https://" + url[len("libsql://"):]
        parts = urllib.parse.urlsplit(url)
        local = parts.hostname in ("127.0.0.1", "localhost", "::1")
        if parts.scheme != "https" and not local:
            raise ViewerError("the database URL must be libsql:// or https://")
        self.url, self.token, self.baton = url.rstrip("/"), token, None

    def _pipeline(self, requests):
        import urllib.request
        body = json.dumps({"baton": self.baton, "requests": requests}).encode()
        req = urllib.request.Request(self.url + "/v2/pipeline", data=body, method="POST",
                                     headers={"Authorization": f"Bearer {self.token}",
                                              "Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                out = json.loads(resp.read())
        except urllib.error.HTTPError as e:
            with e:
                raise sqlite3.OperationalError(f"database said {e.code}: {e.read()[:200]!r}")
        except urllib.error.URLError as e:
            raise sqlite3.OperationalError(f"can't reach the database: {e.reason}")
        self.baton = out.get("baton")
        if out.get("base_url"):
            self.url = out["base_url"].rstrip("/")
        results = []
        for r in out.get("results", []):
            if r.get("type") == "error":
                msg = r.get("error", {}).get("message", "database error")
                cls = sqlite3.IntegrityError if "constraint" in msg.lower() else sqlite3.OperationalError
                raise cls(msg)
            results.append(r.get("response", {}))
        return results

    def execute(self, sql, params=()):
        stmt = {"sql": sql, "args": [turso_arg(v) for v in params]}
        res = self._pipeline([{"type": "execute", "stmt": stmt}])
        return TursoCursor(res[0].get("result", {}))

    def executemany(self, sql, seq):
        reqs = [{"type": "execute", "stmt": {"sql": sql, "args": [turso_arg(v) for v in row]}}
                for row in seq]
        for i in range(0, len(reqs), 200):  # one HTTP call per 200 rows
            self._pipeline(reqs[i:i + 200])

    def executescript(self, script):
        self._pipeline([{"type": "sequence", "sql": script}])

    def close(self):
        if self.baton:
            try:
                self._pipeline([{"type": "close"}])
            except sqlite3.Error:
                pass
            self.baton = None


def data_dir(arg=None):
    return Path(arg or os.environ.get("OMALOCKER_VIEWER_DATA") or "/var/lib/omalocker-viewer")


def db_target(data=None, db=None):
    """Where the database is: a Turso URL (str) or a local data folder (Path)."""
    url = db or (None if data else (os.environ.get("OMALOCKER_VIEWER_DB")
                                    or os.environ.get("TURSO_DATABASE_URL")))
    return url if url else data_dir(data)


def turso_token():
    if os.environ.get("TURSO_AUTH_TOKEN"):
        return os.environ["TURSO_AUTH_TOKEN"].strip()
    path = os.environ.get("OMALOCKER_VIEWER_DB_TOKEN_FILE")
    if path:
        return Path(path).expanduser().read_text().strip()
    raise ViewerError("set TURSO_AUTH_TOKEN or OMALOCKER_VIEWER_DB_TOKEN_FILE for the database")


class LocalConnection:
    """A local sqlite3 connection, with the same .remote flag as TursoConnection."""
    remote = False

    def __init__(self, path):
        self._db = sqlite3.connect(path, isolation_level=None, timeout=10)
        self._db.row_factory = sqlite3.Row
        self._db.execute("PRAGMA foreign_keys = ON")
        self._db.execute("PRAGMA journal_mode = WAL")
        self._db.execute("PRAGMA secure_delete = ON")  # deleted student data is overwritten

    def __getattr__(self, name):
        return getattr(self._db, name)


def connect(target, schema=None):
    """target: a Turso URL (str) or a local data folder (Path). schema: create missing
    tables. Locally that's cheap and done unless schema=False; on Turso every statement
    is a network call, so only when asked (`omalocker-viewer init`)."""
    if isinstance(target, str):
        db = TursoConnection(target, turso_token())
        try:
            db.execute("PRAGMA foreign_keys = ON")
        except sqlite3.Error:
            pass
        if schema:
            db.executescript(SCHEMA)
        return db
    target.mkdir(parents=True, exist_ok=True, mode=0o700)
    db = LocalConnection(target / "viewer.db")
    if schema is not False:
        db.executescript(SCHEMA)
    return db


def load_config(db):
    try:
        rows = db.execute("SELECT key, value FROM settings").fetchall()
    except sqlite3.OperationalError as e:
        if "no such table" not in str(e):
            raise ViewerError(f"database: {e}")
        rows = []
    cfg = {r["key"]: r["value"] for r in rows}
    if cfg.get("env") not in ("staging", "production"):
        raise ViewerError("this viewer isn't set up: run `omalocker-viewer init` first")
    cfg["base_url"] = str(cfg.get("base_url", "")).rstrip("/")
    cfg["secure_cookies"] = cfg["base_url"].startswith("https://")
    cfg.setdefault("timezone", "America/Los_Angeles")
    return cfg


def check_email(cfg, email):
    email = email.strip()
    if not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", email):
        raise ViewerError(f"not an email address: {email!r}")
    test = bool(TEST_DOMAIN.search(email.rsplit("@", 1)[1].lower()))
    if cfg["env"] == "staging" and not test:
        raise ViewerError("staging holds fictional people only: use an address at "
                          "example.org, *.example or *.test")
    if cfg["env"] == "production" and test:
        raise ViewerError("production doesn't take test addresses")
    return email


def person_by_email(db, email):
    row = db.execute("SELECT * FROM people WHERE email = ?", (email.strip(),)).fetchone()
    if not row:
        raise ViewerError(f"no person with email {email}")
    return row


# ---------------------------------------------------------------- who sees what

def allowed_views(db, person):
    """[(student row, audience, scope)] this person may open."""
    rows = db.execute(
        """SELECT g.audience, g.scope, s.* FROM grants g
           JOIN people s ON s.id = g.student_id
           WHERE g.person_id = ? AND (g.audience != 'parent' OR g.primary_custody = 1)
           ORDER BY s.name, g.audience, g.scope""", (person["id"],)).fetchall()
    seen = [(r, r["audience"], r["scope"]) for r in rows]
    if person["is_admin"]:  # admin: same as parent, for every student (docs/plan.md)
        have = {s["id"] for s, a, _ in seen if a == "parent"}
        for s in db.execute("SELECT * FROM people WHERE is_student = 1 ORDER BY name"):
            if s["id"] not in have:
                seen.append((s, "parent", ""))
    return seen


def can_see(db, person, student_id, audience, scope):
    if audience not in AUDIENCES:
        return False
    if audience == "parent" and person["is_admin"]:
        return db.execute("SELECT 1 FROM people WHERE id = ? AND is_student = 1",
                          (student_id,)).fetchone() is not None
    row = db.execute(
        """SELECT primary_custody FROM grants WHERE person_id = ? AND student_id = ?
           AND audience = ? AND scope = ?""",
        (person["id"], student_id, audience, scope)).fetchone()
    return bool(row) and (audience != "parent" or bool(row["primary_custody"]))


# ---------------------------------------------------------------- push

def frontmatter(text):
    """type, role and share from a note's frontmatter: just enough to re-check."""
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return {}
    props, key = {}, None
    for line in lines[1:]:
        if line.strip() == "---":
            break
        m = re.match(r"([A-Za-z_][\w-]*):\s*(.*)$", line)
        if m:
            key, value = m.group(1), m.group(2).strip()
            if value.startswith("[") and value.endswith("]"):
                props[key] = [v.strip().strip("'\"") for v in value[1:-1].split(",") if v.strip()]
            elif value:
                props[key] = value.strip("'\"")
            else:
                props[key] = []
        elif key and re.match(r"\s+-\s*", line) and isinstance(props.get(key), list):
            props[key].append(re.sub(r"^\s+-\s*", "", line).strip().strip("'\""))
    return props


def note_refused(path, text):
    """Why this note can't be in any view, or None. The device already filters;
    this is the viewer refusing to hold what it never should."""
    props = frontmatter(text)
    kind = props.get("type")
    share = props.get("share") or []
    share = share if isinstance(share, list) else [share]
    if kind == "guide" or path == "AGENTS.md":
        return "AGENTS.md is never in a view"
    if "private" in share and kind not in CANT_HIDE:
        return "a private note"
    if kind == "person" and path != "Me.md" and props.get("role") == "student":
        return "a note about a classmate"
    return None


def clean_path(path):
    if not isinstance(path, str) or not path.endswith(".md") or len(path) > 300:
        return None
    parts = path.split("/")
    if path.startswith("/") or any(p in ("", ".", "..") or p.startswith(".") for p in parts):
        return None
    if any(c in path for c in "\\\0\r\n"):
        return None
    return path


def accept_push(db, student_id, payload):
    """Replace every view of this student with the pushed ones. Returns a summary."""
    views = payload.get("views") if isinstance(payload, dict) else None
    if not isinstance(views, list) or not views:
        raise ViewerError("push has no views")
    rows, seen = [], set()
    for v in views:
        audience, scope = v.get("audience"), v.get("scope") or ""
        if audience not in AUDIENCES:
            raise ViewerError(f"unknown audience {audience!r}")
        if (audience in SCOPED) != bool(scope):
            raise ViewerError(f"{audience} views {'need' if audience in SCOPED else 'have no'} scope")
        if not isinstance(scope, str) or len(scope) > 200 or "/" in scope or scope.startswith("."):
            raise ViewerError("bad scope")
        if (audience, scope) in seen:
            raise ViewerError(f"view {audience} {scope} sent twice")
        seen.add((audience, scope))
        as_of = v.get("as_of")
        if not isinstance(as_of, str) or len(as_of) > 40:
            raise ViewerError("every view needs as_of")
        notes, paths = [], set()
        for n in v.get("notes") or []:
            path, text = clean_path(n.get("path")), n.get("text")
            if path is None or not isinstance(text, str) or path in paths:
                raise ViewerError("bad note path or text")
            if len(text.encode()) > MAX_NOTE:
                raise ViewerError(f"a note is over {MAX_NOTE // 1024} KB")
            why = note_refused(path, text)
            if why:
                raise ViewerError(f"refused: the {audience} view holds {why}")
            paths.add(path)
            notes.append((path, str(n.get("type") or ""), 1 if n.get("summary") else 0, text))
        rows.append((audience, scope, as_of, notes))
    pushed = clock()
    db.execute("BEGIN IMMEDIATE")
    try:
        db.execute("DELETE FROM notes WHERE student_id = ?", (student_id,))
        db.execute("DELETE FROM views WHERE student_id = ?", (student_id,))
        for audience, scope, as_of, notes in rows:
            db.execute("INSERT INTO views VALUES (?, ?, ?, ?, ?)",
                       (student_id, audience, scope, as_of, pushed))
            db.executemany("INSERT INTO notes VALUES (?, ?, ?, ?, ?, ?, ?)",
                           [(student_id, audience, scope, *n) for n in notes])
        db.execute("COMMIT")
    except BaseException:
        db.execute("ROLLBACK")
        raise
    return {"views": len(rows), "notes": sum(len(r[3]) for r in rows)}


# ---------------------------------------------------------------- markdown
#
# A small, safe renderer: everything is escaped first; only the shapes below
# become HTML. Student-written text never reaches the page as markup.

LINK_RE = re.compile(r"!?\[\[([^\]|#^]*)(?:[#^][^\]|]*)?(?:\|([^\]]*))?\]\]")
MD_LINK_RE = re.compile(r"\[([^\]]+)\]\((https?://[^\s)]+)\)")


def inline(text, resolve):
    """text is raw; returns HTML."""
    out, pos = [], 0
    for m in LINK_RE.finditer(text):
        out.append(inline_plain(text[pos:m.start()]))
        target, alias = m.group(1).strip(), m.group(2)
        label = html.escape((alias or target).strip())
        href = resolve(target)
        out.append(f'<a href="{html.escape(href)}">{label}</a>' if href
                   else f'<span class="unlinked">{label}</span>')
        pos = m.end()
    out.append(inline_plain(text[pos:]))
    return "".join(out)


def inline_plain(text):
    parts = re.split(r"(`[^`]+`)", text)
    out = []
    for part in parts:
        if len(part) > 1 and part.startswith("`") and part.endswith("`"):
            out.append(f"<code>{html.escape(part[1:-1])}</code>")
            continue
        links = []

        def keep(m):
            links.append(f'<a href="{html.escape(m.group(2))}" rel="noopener noreferrer">'
                         f'{html.escape(m.group(1))}</a>')
            return f"\0{len(links) - 1}\0"
        s = html.escape(MD_LINK_RE.sub(keep, part))
        s = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", s)
        s = re.sub(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])", r"<em>\1</em>", s)
        s = re.sub(r"\0(\d+)\0", lambda m: links[int(m.group(1))], s)
        out.append(s)
    return "".join(out)


def split_front(text):
    lines = text.split("\n")
    if lines and lines[0].strip() == "---":
        for i, line in enumerate(lines[1:], 1):
            if line.strip() == "---":
                return lines[1:i], "\n".join(lines[i + 1:])
    return [], text


def render_markdown(text, resolve, title=None):
    front, body = split_front(text)
    body = re.sub(r"<!--.*?-->", "", body, flags=re.S)
    out = []
    if title and not re.search(r"(?m)^#\s", body):
        out.append(f"<h2>{html.escape(title)}</h2>")
    if front:
        props = frontmatter("---\n" + "\n".join(front) + "\n---")
        rows = []
        for key, value in props.items():
            values = [v for v in (value if isinstance(value, list) else [value]) if str(v).strip()]
            if key in HIDDEN_PROPS or not values:
                continue
            shown = [nice_date(v) if re.fullmatch(r"\d{4}-\d{2}-\d{2}", str(v)) else str(v)
                     for v in values]
            cell = ", ".join(inline(v, resolve) for v in shown)
            label = key.replace("_", " ").capitalize()
            rows.append(f"<tr><th>{html.escape(label)}</th><td>{cell}</td></tr>")
        if rows:
            out.append('<table class="props">' + "".join(rows) + "</table>")
    lines, i, para = body.split("\n"), 0, []

    def flush():
        if para:
            out.append("<p>" + inline(" ".join(para), resolve) + "</p>")
            para.clear()

    while i < len(lines):
        line = lines[i]
        stripped = line.strip()
        if stripped.startswith("```"):
            flush()
            code, i = [], i + 1
            while i < len(lines) and not lines[i].strip().startswith("```"):
                code.append(lines[i])
                i += 1
            out.append("<pre><code>" + html.escape("\n".join(code)) + "</code></pre>")
            i += 1
            continue
        m = re.match(r"(#{1,6})\s+(.*)", stripped)
        if m:
            flush()
            n = len(m.group(1))
            out.append(f"<h{n}>{inline(m.group(2), resolve)}</h{n}>")
        elif re.match(r"([-*+]|\d+[.)])\s+", stripped):
            flush()
            ordered = bool(re.match(r"\d", stripped))
            tag = "ol" if ordered else "ul"
            items = []
            while i < len(lines) and re.match(r"\s*([-*+]|\d+[.)])\s+", lines[i]):
                item = re.sub(r"^\s*([-*+]|\d+[.)])\s+", "", lines[i])
                box = re.match(r"\[([ xX])\]\s*(.*)", item)
                if box:
                    mark = "☑" if box.group(1) != " " else "☐"
                    items.append(f"<li>{mark} {inline(box.group(2), resolve)}</li>")
                else:
                    items.append(f"<li>{inline(item, resolve)}</li>")
                i += 1
            out.append(f"<{tag}>" + "".join(items) + f"</{tag}>")
            continue
        elif stripped.startswith("|"):
            flush()
            rows = []
            while i < len(lines) and lines[i].strip().startswith("|"):
                cells = [c.strip() for c in lines[i].strip().strip("|").split("|")]
                if not all(re.fullmatch(r":?-+:?", c) for c in cells if c):
                    rows.append(cells)
                i += 1
            if rows:
                head = "".join(f"<th>{inline(c, resolve)}</th>" for c in rows[0])
                body_rows = "".join(
                    "<tr>" + "".join(f"<td>{inline(c, resolve)}</td>" for c in r) + "</tr>"
                    for r in rows[1:])
                out.append(f"<table><thead><tr>{head}</tr></thead><tbody>{body_rows}</tbody></table>")
            continue
        elif stripped.startswith(">"):
            flush()
            quote = []
            while i < len(lines) and lines[i].strip().startswith(">"):
                quote.append(lines[i].strip()[1:].strip())
                i += 1
            out.append("<blockquote>" + inline(" ".join(quote), resolve) + "</blockquote>")
            continue
        elif not stripped:
            flush()
        else:
            para.append(stripped)
        i += 1
    flush()
    return "\n".join(out)


