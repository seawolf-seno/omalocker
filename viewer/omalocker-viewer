class Viewer:
    def __init__(self, target):
        self.target = target
        self._local = threading.local()
        self.cfg = load_config(self.db)

    @property
    def db(self):
        # One connection per server thread: transactions don't mix.
        if getattr(self._local, "db", None) is None:
            self._local.db = connect(self.target, schema=False)
        return self._local.db

    def close_thread_db(self):
        db = getattr(self._local, "db", None)
        if db is not None:
            db.close()
            self._local.db = None

    # -- sessions
    def session_person(self, cookie_header):
        if not cookie_header:
            return None
        token = None
        for part in cookie_header.split(";"):
            name, _, value = part.strip().partition("=")
            if name == COOKIE:
                token = value
        if not token:
            return None
        return self.db.execute(
            """SELECT p.* FROM sessions s JOIN people p ON p.id = s.person_id
               WHERE s.token_hash = ? AND s.expires > ?""",
            (digest(token), clock())).fetchone()

    def sign_in(self, token):
        """Use a sign-in link once. Returns a new session token, or None."""
        h = digest(token or "")
        self.db.execute("BEGIN IMMEDIATE")
        try:
            row = self.db.execute("SELECT * FROM sign_in WHERE token_hash = ?", (h,)).fetchone()
            self.db.execute("DELETE FROM sign_in WHERE token_hash = ? OR expires <= ?",
                            (h, clock()))
            if not row or row["expires"] <= clock():
                self.db.execute("COMMIT")
                return None
            session = secrets.token_urlsafe(32)
            self.db.execute("DELETE FROM sessions WHERE expires <= ?", (clock(),))
            self.db.execute("INSERT INTO sessions VALUES (?, ?, ?)",
                            (digest(session), row["person_id"], clock() + SESSION_TTL))
            self.db.execute("COMMIT")
            return session, row["person_id"]
        except BaseException:
            self.db.execute("ROLLBACK")
            raise

    def sign_out(self, cookie_header):
        for part in (cookie_header or "").split(";"):
            name, _, value = part.strip().partition("=")
            if name == COOKIE:
                self.db.execute("DELETE FROM sessions WHERE token_hash = ?", (digest(value),))

    def push_student(self, auth_header):
        m = re.fullmatch(r"Bearer ([\w-]{20,200})", (auth_header or "").strip())
        if not m:
            return None
        row = self.db.execute("SELECT student_id FROM push_tokens WHERE token_hash = ?",
                              (digest(m.group(1)),)).fetchone()
        return row["student_id"] if row else None

    # -- pages
    def home_page(self, person):
        views = allowed_views(self.db, person)
        if not views:
            body = (f"<h1>Hi {esc(person['name'])}</h1><p>Nothing is shared with you yet. "
                    "If that's wrong, ask the school office.</p>")
            return page(self.cfg, "Home", body, person)
        by_student = {}
        for s, audience, scope in views:
            by_student.setdefault(s["id"], (s, []))[1].append((audience, scope))
        parts = [f"<h1>Hi {esc(person['name'])}</h1>"]
        for s, entries in by_student.values():
            items = []
            for audience, scope in entries:
                v = self.db.execute(
                    "SELECT as_of FROM views WHERE student_id = ? AND audience = ? AND scope = ?",
                    (s["id"], audience, scope)).fetchone()
                label = AUDIENCE_LABEL[audience] + (f": {esc(scope)}" if scope else "")
                when = (f"Updated {esc(nice_time(self.cfg, v['as_of']))}" if v
                        else "Not shared from the student's laptop yet")
                items.append(f'<li><a class="card" href="{view_url(s["id"], audience, scope)}">'
                             f'<div class="title">{label}</div><div class="sub">{when}</div></a></li>')
            parts.append(f'<h2>{esc(s["name"])}</h2><ul class="cards">{"".join(items)}</ul>')
        return page(self.cfg, "Home", "".join(parts), person)

    def view_header(self, person, student, audience, scope, v, back=None):
        many = len(allowed_views(self.db, person)) > 1
        link = back or ("/", "All students") if many or back else None
        top = f'<a class="back" href="{link[0]}">← {esc(link[1])}</a>' if link else ""
        label = "" if audience == "parent" else (
            f"{AUDIENCE_LABEL[audience]}{': ' + esc(scope) if scope else ''} · ")
        return (f'{top}<h1>{esc(student["name"])}</h1>'
                f'<p class="asof">{label}Updated {esc(nice_time(self.cfg, v["as_of"]))} '
                f"from {'their' if audience == 'parent' else 'the student’s'} laptop</p>")

    def index_page(self, person, student, audience, scope, show_all):
        v = self.db.execute(
            "SELECT * FROM views WHERE student_id = ? AND audience = ? AND scope = ?",
            (student["id"], audience, scope)).fetchone()
        if not v:
            body = (f'<h1>{esc(student["name"])}</h1>'
                    "<p>Nothing here yet: this hasn't been shared from the student's laptop.</p>")
            return page(self.cfg, student["name"], body, person)
        notes = self.db.execute(
            """SELECT path, type, summary, text FROM notes WHERE student_id = ? AND audience = ?
               AND scope = ? ORDER BY path""", (student["id"], audience, scope)).fetchall()
        first_page = audience == "parent" and not show_all
        shown = [n for n in notes if n["summary"]] if first_page else notes
        base = view_url(student["id"], audience, scope)
        sections = {}
        for n in shown:
            if first_page and n["path"] == "Me.md":
                continue  # the student's name is the page title; "About me" is one tap away
            sections.setdefault(SECTION_OF.get(n["type"], "Other"), []).append(n)
        order = list(dict.fromkeys(label for _, label in SECTIONS)) + ["Other"]
        back = (base, "Overview") if audience == "parent" and show_all else None
        parts = [self.view_header(person, student, audience, scope, v, back)]
        for label in sorted(sections, key=order.index):
            group = sections[label]
            if group[0]["type"] in NEWEST_FIRST:
                group = sorted(group, key=lambda n: n["path"], reverse=True)
            items = []
            for n in group:
                props = frontmatter(n["text"])
                sub = note_sub(n["type"], props, n["text"])
                extra = ""
                if n["type"] == "mastery":
                    extra = "".join(f'<li><span>{esc(idea)}</span><span class="level">{esc(lvl)}</span></li>'
                                    for idea, lvl in mastery_levels(n["text"]))
                    extra = f'<ul class="levels">{extra}</ul>' if extra else ""
                items.append(
                    f'<li><a class="card" href="{note_url(base, n["path"])}">'
                    f'<div class="title">{esc(note_title(n["path"], n["type"]))}</div>'
                    + (f'<div class="sub">{esc(sub)}</div>' if sub else "") + extra + "</a></li>")
            parts.append(f'<h2>{esc(label)}</h2><ul class="cards">{"".join(items)}</ul>')
        if first_page and len(notes) > len(shown):
            parts.append(f'<a class="more" href="{base}?all=1">Show everything '
                         f"({len(notes)} notes: work, journal, activities…)</a>")
        return page(self.cfg, student["name"], "".join(parts), person)

    def note_page(self, person, student, audience, scope, path):
        v = self.db.execute(
            "SELECT * FROM views WHERE student_id = ? AND audience = ? AND scope = ?",
            (student["id"], audience, scope)).fetchone()
        note = self.db.execute(
            """SELECT * FROM notes WHERE student_id = ? AND audience = ? AND scope = ?
               AND path = ?""", (student["id"], audience, scope, path)).fetchone() if v else None
        if not note:
            return None
        rows = self.db.execute(
            "SELECT path, summary FROM notes WHERE student_id = ? AND audience = ? AND scope = ?",
            (student["id"], audience, scope)).fetchall()
        by_name = {}
        for r in rows:
            stem = r["path"].removesuffix(".md")
            by_name.setdefault(stem.lower(), r["path"])
            by_name.setdefault(stem.rsplit("/", 1)[-1].lower(), r["path"])
        base = view_url(student["id"], audience, scope)

        def resolve(target):
            p = by_name.get(target.strip().lower().removesuffix(".md"))
            return note_url(base, p) if p else None

        back = base + ("" if audience != "parent" or note["summary"] else "?all=1")
        title = note_title(path, note["type"])
        body = (self.view_header(person, student, audience, scope, v,
                                 (back, "Back to " + ("everything" if back.endswith("all=1")
                                                      else "the overview")))
                + "<article>" + render_markdown(note["text"], resolve, title) + "</article>")
        return page(self.cfg, title, body, person)


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "omalocker-viewer"
    sys_version = ""
    viewer = None  # set by make_server

    def log_message(self, fmt, *args):
        # No paths in logs: they can hold student and note names.
        if os.environ.get("OMALOCKER_VIEWER_QUIET"):
            return
        sys.stderr.write(f"{self.log_date_time_string()} {self.command} {args[1] if len(args) > 1 else ''}\n")

    def send(self, status, body=b"", ctype="text/html; charset=utf-8", headers=()):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy",
                         "default-src 'none'; style-src 'self'; img-src 'self'; "
                         "form-action 'self'; frame-ancestors 'none'; base-uri 'none'")
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def not_found(self, person=None):
        v = self.viewer
        self.send(404, page(v.cfg, "Not found", "<h1>Not found</h1>"
                            '<p>This page doesn\'t exist, or isn\'t shared with you.</p>'
                            '<p><a href="/">Home</a></p>', person))

    def redirect(self, where, headers=()):
        self.send(303, b"", headers=[("Location", where), *headers])

    def cookie(self, value, max_age):
        secure = "; Secure" if self.viewer.cfg["secure_cookies"] else ""
        return ("Set-Cookie", f"{COOKIE}={value}; Max-Age={max_age}; Path=/; HttpOnly; "
                              f"SameSite=Strict{secure}")

    def read_body(self, limit):
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = -1
        if length < 0 or length > limit:
            return None
        return self.rfile.read(length)

    def finish(self):
        try:
            super().finish()
        finally:
            self.viewer.close_thread_db()

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        v = self.viewer
        url = urllib.parse.urlsplit(self.path)
        query = urllib.parse.parse_qs(url.query)
        if url.path == "/style.css":
            return self.send(200, STYLE, "text/css; charset=utf-8")
        if url.path == "/signin":
            token = (query.get("t") or [""])[0]
            body = ("<h1>Welcome</h1><p>Tap the button to open your student's Locker. "
                    "No password needed.</p><form method=\"post\" action=\"/signin\">"
                    f'<input type="hidden" name="t" value="{esc(token)}">'
                    '<button class="big">Open OmaLocker</button></form>'
                    '<p class="muted">This link works once, for 15 minutes. You stay signed in '
                    "on this phone for 30 days.</p>")
            return self.send(200, page(v.cfg, "Sign in", body))
        person = v.session_person(self.headers.get("Cookie"))
        if url.path == "/":
            if not person:
                body = ("<h1>OmaLocker</h1><p>Open the sign-in link the school emailed you. "
                        "Need a new one? Ask the school office.</p>")
                return self.send(200, page(v.cfg, "Sign in", body))
            views = allowed_views(v.db, person)
            if len(views) == 1:  # one child, one view: go straight there
                s, audience, scope = views[0]
                return self.redirect(view_url(s["id"], audience, scope))
            return self.send(200, v.home_page(person))
        if not person:
            return self.redirect("/")
        parts = [urllib.parse.unquote(p) for p in url.path.split("/")[1:]]
        if len(parts) < 3 or parts[0] != "s" or not parts[1].isdigit():
            return self.not_found(person)
        student_id, audience, rest = int(parts[1]), parts[2], parts[3:]
        scope = ""
        if audience in SCOPED:
            if not rest or not rest[0]:
                return self.not_found(person)
            scope, rest = rest[0], rest[1:]
        if rest and rest[-1] == "":
            rest = rest[:-1]
        note_path = "/".join(rest[1:]) if rest and rest[0] == "n" else ""
        if not can_see(v.db, person, student_id, audience, scope):
            audit(v.db, person, "open", student_id, audience, scope, note_path, "denied")
            return self.not_found(person)
        student = v.db.execute("SELECT * FROM people WHERE id = ?", (student_id,)).fetchone()
        if not rest:
            show_all = bool(query.get("all"))
            audit(v.db, person, "open", student_id, audience, scope,
                  detail="everything" if show_all else "")
            return self.send(200, v.index_page(person, student, audience, scope, show_all))
        if note_path:
            html_page = v.note_page(person, student, audience, scope, note_path)
            audit(v.db, person, "open", student_id, audience, scope, note_path,
                  "ok" if html_page else "missing")
            if html_page:
                return self.send(200, html_page)
        return self.not_found(person)

    def do_POST(self):
        v = self.viewer
        path = urllib.parse.urlsplit(self.path).path
        if path == "/api/push":
            student_id = v.push_student(self.headers.get("Authorization"))
            if student_id is None:
                audit(v.db, "device", "push", result="denied", detail="bad push token")
                return self.send(401, json.dumps({"error": "bad push token"}), "application/json")
            raw = self.read_body(MAX_PUSH)
            if raw is None:
                return self.send(413, json.dumps({"error": "push too large"}), "application/json")
            try:
                result = accept_push(v.db, student_id, json.loads(raw))
            except (ValueError, ViewerError, AttributeError, TypeError) as e:
                msg = str(e) if isinstance(e, ViewerError) else "push isn't valid JSON views"
                audit(v.db, "device", "push", student_id, result="refused", detail=msg)
                return self.send(422, json.dumps({"error": msg}), "application/json")
            audit(v.db, "device", "push", student_id,
                  detail=f"{result['views']} views, {result['notes']} notes")
            return self.send(200, json.dumps({"ok": True, **result}), "application/json")
        raw = self.read_body(4096)
        form = urllib.parse.parse_qs((raw or b"").decode(errors="replace"))
        if path == "/signin":
            signed = v.sign_in((form.get("t") or [""])[0])
            if not signed:
                audit(v.db, "unknown", "sign-in", result="denied",
                      detail="used, expired or unknown link")
                body = ("<h1>That link has expired</h1><p>Sign-in links work once, for 15 "
                        "minutes. Ask the school office for a new one.</p>")
                return self.send(400, page(v.cfg, "Sign in", body))
            session, person_id = signed
            who = v.db.execute("SELECT * FROM people WHERE id = ?", (person_id,)).fetchone()
            audit(v.db, who, "sign-in")
            return self.redirect("/", [self.cookie(session, SESSION_TTL)])
        if path == "/signout":
            who = v.session_person(self.headers.get("Cookie"))
            if who:
                audit(v.db, who, "sign-out")
            v.sign_out(self.headers.get("Cookie"))
            return self.redirect("/", [self.cookie("", 0)])
        return self.not_found()


def make_server(target, host, port):
    viewer = Viewer(target)
    handler = type("BoundHandler", (Handler,), {"viewer": viewer})
    server = http.server.ThreadingHTTPServer((host, port), handler)
    server.daemon_threads = True
    return server


def vercel_viewer():
    """The Viewer for Vercel's Python runtime (api/index.py). Settings and data come
    from Turso: TURSO_DATABASE_URL and TURSO_AUTH_TOKEN."""
    target = os.environ.get("OMALOCKER_VIEWER_DB") or os.environ.get("TURSO_DATABASE_URL")
    if not target:
        raise ViewerError("set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN")
    return Viewer(target)


# ---------------------------------------------------------------- admin CLI

def cmd_init(args):
    target = db_target(args.data, args.db)
    db = connect(target, schema=True)
    _admin_dbs.append(db)
    where = target if isinstance(target, str) else target / "viewer.db"
    existing = {r["key"]: r["value"] for r in db.execute("SELECT key, value FROM settings")}
    if existing.get("env"):
        print(f"already set up ({existing['env']}): {where}; tables brought up to date")
        return 0
    if not args.env or not args.base_url:
        raise ViewerError("a new viewer needs --env and --base-url")
    base = args.base_url.rstrip("/")
    if args.env == "production" and not base.startswith("https://"):
        raise ViewerError("production needs an https:// base URL")
    db.executemany("INSERT INTO settings VALUES (?, ?)",
                   [("env", args.env), ("base_url", base), ("timezone", args.timezone)])
    audit(db, cli_actor(), "init", detail=f"{args.env} {base}")
    print(f"set up {args.env} viewer: {where}")
    return 0


_admin_dbs = []


def open_admin(args):
    db = connect(db_target(args.data, args.db), schema=False)
    _admin_dbs.append(db)
    return load_config(db), db


def cmd_person(args):
    cfg, db = open_admin(args)
    email = check_email(cfg, args.email)
    if args.grad_year and not args.student:
        raise ViewerError("--grad-year is for students")
    try:
        cur = db.execute("INSERT INTO people (name, email, is_student, grad_year, is_admin) "
                         "VALUES (?, ?, ?, ?, ?)",
                         (args.name, email, int(args.student), args.grad_year, int(args.admin)))
    except sqlite3.IntegrityError:
        raise ViewerError(f"{email} is already here")
    audit(db, cli_actor(), "person-add", cur.lastrowid if args.student else None,
          detail=f"{email}{' student' if args.student else ''}{' admin' if args.admin else ''}")
    print(f"added {args.name} (id {cur.lastrowid})")
    return 0


def cmd_grant(args, revoke=False):
    cfg, db = open_admin(args)
    person, student = person_by_email(db, args.person), person_by_email(db, args.student)
    if not student["is_student"]:
        raise ViewerError(f"{args.student} isn't a student")
    scope = (args.scope or "").strip()
    if (args.audience in SCOPED) != bool(scope):
        raise ViewerError(f"{args.audience} grants {'need' if args.audience in SCOPED else 'take no'} --scope")
    if revoke:
        n = db.execute("DELETE FROM grants WHERE person_id = ? AND student_id = ? AND audience = ? "
                       "AND scope = ?", (person["id"], student["id"], args.audience, scope)).rowcount
        if n:
            audit(db, cli_actor(), "revoke", student["id"], args.audience, scope,
                  detail=person["email"])
        print("revoked" if n else "nothing to revoke")
        return 0
    if args.primary_custody and args.audience != "parent":
        raise ViewerError("--primary-custody is for parent grants")
    if person["id"] == student["id"]:
        raise ViewerError("a student has their own Locker; no grant needed")
    db.execute("INSERT OR REPLACE INTO grants VALUES (?, ?, ?, ?, ?)",
               (person["id"], student["id"], args.audience, scope, int(args.primary_custody)))
    audit(db, cli_actor(), "grant", student["id"], args.audience, scope,
          detail=person["email"] + (" primary custody" if args.primary_custody else ""))
    note = ""
    if args.audience == "parent" and not args.primary_custody:
        note = " (no primary custody: recorded, but this parent sees no view)"
    print(f"granted {args.audience}{' ' + scope if scope else ''}{note}")
    return 0


def cmd_sign_in_link(args):
